{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "cgpa-calculator-ai",
	"main": "src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}
