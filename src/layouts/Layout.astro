---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getPageSEO } from '../lib/seo.ts';

const { title = 'CGPA Calculator AI', description = '', pathname = '/', noAds = false } = Astro.props;
const seo = getPageSEO({ title, description, pathname });

const canonical = `${new URL(Astro.request.url).origin}${pathname}`;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "CGPA Calculator AI",
  "url": canonical,
  "description": seo.description,
  "applicationCategory": "Education",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
});
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

    {/* Inline theme script — runs before first paint to prevent flash */}
    <script is:inline>
      (() => {
        try {
          const html = document.documentElement;
          const saved = localStorage.getItem('cgpa-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const shouldDark = saved === 'dark' || (!saved && prefersDark);
          if (shouldDark) html.setAttribute('data-theme', 'dark');
          else html.removeAttribute('data-theme');
        } catch (e) {}
      })();
    </script>

    <link rel="canonical" href={canonical} />

    {/* Favicons */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="CGPA Calculator AI" />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:site_name" content="CGPA Calculator AI" />
    <meta property="og:image" content="/og-image.png" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content="/og-image.png" />

    <script type="application/ld+json" set:html={jsonLd}></script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LQYX0BC4Z6"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-LQYX0BC4Z6');
    </script>
  </head>
  <body>
    <a class="sr-only" href="#main-content">Skip to main content</a>

    <Nav />

    <main id="main-content">
      <slot />
    </main>

    <Footer noAds={noAds} />

    <style>
      :focus-visible {
        outline: 2px solid var(--color-link);
        outline-offset: 2px;
      }
    </style>
  </body>
</html>
