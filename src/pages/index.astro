---
import Layout from '../layouts/Layout.astro';
import { getUniversities } from '../lib/data.ts';

const homeTitle = 'CGPA Calculator — Free VTU SGPA, CGPA & Percentage Tool';
const homeDescription = 'Free CGPA calculator for VTU, Anna University, KTU, SRM, VIT, IPU & Saveetha. Convert SGPA to CGPA, CGPA to percentage, percentage to CGPA. VTU 2022 scheme, 2021, 2018, 2025. No signup, no data stored.';
---

<Layout title={homeTitle} description={homeDescription} pathname="/">
  <section class="hero-band" style="position: relative; overflow: hidden;">
    <div style="position: absolute; inset: -10%; opacity: 0.9; pointer-events: none; z-index: 0;" class="mesh-gradient"></div>
    <div class="container" style="position: relative; z-index: 1;">
      <div class="hero-copy">
        <p class="eyebrow" style="margin: 0;">No ads · No login · Credits pre-filled</p>
        <h1 class="display-xl" style="margin: 10px 0 16px;">Your marks card, without the panic.</h1>
        <p class="body-lg" style="margin: 0 0 20px; max-width: 58ch;">Tap grades. Watch SGPA, CGPA and percentage update live. Built for VTU students first — and for Anna, KTU, SRM, VIT, IPU and Saveetha too.</p>
        <div class="trust-row" style="margin-bottom: 22px;">
          <span class="trust-chip">Tap-to-grade, not dropdown hell</span>
          <span class="trust-chip">Formulas shown, not hidden</span>
          <span class="trust-chip">Lives only in your browser</span>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <a href="/vtu/2022/cse/sgpa" class="button-primary">Start VTU SGPA</a>
          <a href="/universities" class="button-secondary">Pick university</a>
        </div>
      </div>

      <div class="grid-tools" style="margin-top: 36px;">
        <a href="/vtu/2022/cse/sgpa" class="tool-tile">
          <span class="kicker">Semester</span>
          <h2 class="heading-md" style="margin:0;">SGPA calculator</h2>
          <p class="body-sm" style="margin:0;">Tap S / A / B on each subject. Credits are already filled for your branch.</p>
        </a>
        <a href="/vtu/2022/cse/cgpa" class="tool-tile">
          <span class="kicker">Whole degree</span>
          <h2 class="heading-md" style="margin:0;">CGPA calculator</h2>
          <p class="body-sm" style="margin:0;">Drop in each semester’s SGPA. Lateral entry skips 1–2 automatically.</p>
        </a>
        <a href="/vtu/2022/cse/percentage" class="tool-tile">
          <span class="kicker">Convert</span>
          <h2 class="heading-md" style="margin:0;">Percentage</h2>
          <p class="body-sm" style="margin:0;">CGPA × 9.5 for VTU — plus class/division as you type.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 24px;">
    <div class="container">
      <div style="display:grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
        <div class="feature-card">
          <div class="step-num">1</div>
          <h3 class="heading-md" style="margin: 12px 0 6px;">Pick scheme &amp; branch</h3>
          <p class="body-sm" style="margin:0;">2025 / 2022 / 2021 / 2018. CSE, ECE, ME and the rest — subjects load instantly.</p>
        </div>
        <div class="feature-card">
          <div class="step-num">2</div>
          <h3 class="heading-md" style="margin: 12px 0 6px;">Tap the grade chips</h3>
          <p class="body-sm" style="margin:0;">No hunting through dropdowns. One tap per subject, phone-friendly.</p>
        </div>
        <div class="feature-card">
          <div class="step-num">3</div>
          <h3 class="heading-md" style="margin: 12px 0 6px;">See class, not just a number</h3>
          <p class="body-sm" style="margin:0;">SGPA, credits, points and distinction / first class update as you go.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 24px;">
    <div class="container">
      <p class="eyebrow" style="margin: 0 0 var(--spacing-xs) 0;">Supported universities</p>
      <h2 class="heading-lg" style="margin-bottom: 8px;">One calculator. Many campuses.</h2>
      <p class="body-md" style="margin-bottom: var(--spacing-lg); max-width: 60ch;">University, scheme, branch, subjects and credits live in data — so your calculator matches your syllabus, not a generic spreadsheet.</p>
      <div style="display: grid; gap: var(--spacing-lg); grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));">
        {getUniversities().map((uni) => (
          <div class="feature-card uni-card">
            <div style="display:flex; gap:12px; align-items:flex-start; margin-bottom: 12px;">
              <div class="uni-badge">{uni.id.slice(0,3).toUpperCase()}</div>
              <div>
                <h3 class="heading-md" style="margin: 0 0 4px 0;">{uni.name}</h3>
                <p class="body-sm mute" style="margin:0;">{uni.domain}</p>
              </div>
            </div>
            <ul style="margin: 0 0 16px; padding-left: 18px; color: var(--color-mute); font-size: var(--font-size-body-sm);">
              {uni.schemes.map((s) => (
                <li style="margin-bottom: 4px;">{s.name}</li>
              ))}
            </ul>
            <a href={`/${uni.id}/${uni.schemes.find(s => s.status === 'verified')?.id ?? uni.schemes[0]?.id}/cse/sgpa`} class="button-primary-sm">Open {uni.id.toUpperCase()} calculator</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ===== SEO CONTENT SECTION (800-1200 words) ===== */}
  <section class="section" style="background: var(--color-canvas-elevated);">
    <div class="container" style="max-width: 800px;">
      <article style="display: grid; gap: var(--spacing-lg);">
        <h2 class="heading-lg" style="margin-bottom: var(--spacing-md);">What is a CGPA Calculator?</h2>
        <p class="body-md" style="margin-bottom: var(--spacing-md);">
          A <strong>CGPA calculator</strong> is a free online tool that helps students compute their <strong>Cumulative Grade Point Average (CGPA)</strong> — the overall academic score across all semesters of a degree program. Unlike a single-semester SGPA, CGPA aggregates every subject and every semester into one number that universities, employers and postgraduate programs use to judge academic performance. Our CGPA calculator is built for students of <strong>VTU (Visvesvaraya Technological University)</strong>, <strong>Anna University</strong>, <strong>KTU (APJ Abdul Kalam Technological University)</strong>, <strong>SRM Institute of Science and Technology</strong>, <strong>VIT (Vellore Institute of Technology)</strong>, <strong>IPU (Guru Gobind Singh Indraprastha University)</strong>, <strong>Saveetha University</strong> and many other Indian universities. It is free, requires no account, stores nothing on a server, and works on any phone or laptop.
        </p>

        <h2 class="heading-md" style="margin: var(--spacing-lg) 0 var(--spacing-sm) 0;">CGPA Full Form and Meaning</h2>
        <p class="body-md" style="margin-bottom: var(--spacing-md);">
          The <strong>CGPA full form</strong> is <strong>Cumulative Grade Point Average</strong>. It is the weighted average of the grade points earned across all semesters of your course. In a 10-point grading system (used by VTU, Anna University, KTU, SRM, VIT, IPU and Saveetha), each subject grade (S, A, B, C, D, E, F) carries a grade point from 10 down to 0. The CGPA is the total credit points divided by total credits. A CGPA of 8.5 and above is typically "First Class with Distinction," 6.5–8.4 is "First Class," 5.0–6.4 is "Second Class," and below 4.0 is a fail. Because CGPA is cumulative, a single bad semester can pull it down, and a strong final semester can lift it up — which is exactly why a good CGPA calculator matters.
        </p>

        <h2 class="heading-md" style="margin: var(--spacing-lg) 0 var(--spacing-sm) 0;">SGPA to CGPA Calculator</h2>
        <p class="body-md" style="margin-bottom: var(--spacing-md);">
          Our <strong>SGPA to CGPA calculator</strong> converts semester-wise SGPA values into an overall CGPA. You simply enter your SGPA for each semester along with the credits of that semester, and the tool computes the credit-weighted CGPA. This is the most accurate method because it weights each semester by its credits rather than averaging SGPAs blindly. Students searching for "sgpa to cgpa calculator" often need exactly this — a tool that respects credit weights and lateral-entry rules (where the first two semesters are skipped). Our calculator handles both regular and lateral-entry students correctly.
        </p>

        <h2 class="heading-md" style="margin: var(--spacing-lg) 0 var(--spacing-sm) 0;">Percentage to CGPA Calculator</h2>
        <p class="body-md" style="margin-bottom: var(--spacing-md);">
          The <strong>percentage to CGPA calculator</strong> converts your percentage score into its CGPA equivalent. For VTU, the standard conversion is <strong>CGPA × 9.5 = Percentage</strong>, so <strong>CGPA to percentage</strong> is <strong>Percentage ÷ 9.5 = CGPA</strong>. For example, a CGPA of 8.0 equals 76% (8.0 × 9.5). Our converter also supports CGPA to 4.0 GPA conversion (WES-style: CGPA ÷ 10 × 4) and class/division classification, so you can see where your CGPA stands for placements and higher studies.
        </p>

        <h2 class="heading-md" style="margin: var(--spacing-lg) 0 var(--spacing-sm) 0;">VTU CGPA Calculator (2025, 2022, 2021, 2018 Scheme)</h2>
        <p class="body-md" style="margin-bottom: var(--spacing-md);">
          The <strong>VTU CGPA calculator</strong> is our most-used tool. VTU (Visvesvaraya Technological University) follows a 10-point grading system with grades S (10), A (9), B (8), C (7), D (6), E (5), F (0). Credits are pre-filled for every subject, semester and branch, so you only enter grades. We support VTU CGPA calculators across all schemes. The <strong>VTU CGPA to percentage</strong> conversion uses the official multiplier of 9.5.
        </p>

        <h2 class="heading-md" style="margin: var(--spacing-lg) 0 var(--spacing-sm) 0;">VIT CGPA Calculator and CGPA Calculator VIT</h2>
        <p class="body-md" style="margin-bottom: var(--spacing-md);">
          Students searching for a <strong>VIT CGPA calculator</strong> or <strong>CGPA calculator VIT</strong> can use our generic 10-point credit-weighted calculator while VIT-specific subject data is being added. The same applies to the <strong>SRM CGPA calculator</strong> and <strong>CGPA calculator SRM</strong> — SRM follows a 10-point system and our calculator supports it through the generic credit-weighted mode. Use the "Request your college" form to ask us to add your university's full subject/credit data.
        </p>

        <h2 class="heading-md" style="margin: var(--spacing-lg) 0 var(--spacing-sm) 0;">KTU CGPA Calculator</h2>
        <p class="body-md" style="margin-bottom: var(--spacing-md);">
          The <strong>KTU CGPA calculator</strong> (for APJ Abdul Kalam Technological University, Kerala) is supported via the generic credit-weighted mode. KTU uses a 10-point grading scale with grades O, A+, A, B+, B, C+, C, D, E, F. Enter your subjects, credits and grades and the calculator computes your SGPA and CGPA. Full KTU subject data will be added in a future data-only update.
        </p>

        <h2 class="heading-md" style="margin: var(--spacing-lg) 0 var(--spacing-sm) 0;">CGPA Calculator Anna University</h2>
        <p class="body-md" style="margin-bottom: var(--spacing-md);">
          The <strong>CGPA calculator Anna University</strong> follows Anna University's 10-point grading system. Our generic calculator supports Anna University's credit-weighted formula. Full Anna University subject and credit data is on our roadmap — request it via the form and we'll prioritize it.
        </p>

        <h2 class="heading-md" style="margin: var(--spacing-lg) 0 var(--spacing-sm) 0;">IPU CGPA Calculator and Saveetha CGPA Calculator</h2>
        <p class="body-md" style="margin-bottom: var(--spacing-md);">
          The <strong>IPU CGPA calculator</strong> (Guru Gobind Singh Indraprastha University, Delhi) and the <strong>Saveetha CGPA calculator</strong> (Saveetha Institute of Medical and Technical Sciences) are both supported through the generic credit-weighted mode. Enter your subjects, credits and grades and get instant SGPA and CGPA. Full pre-filled subject data for IPU and Saveetha will be added as data-only updates.
        </p>

        <h2 class="heading-md" style="margin: var(--spacing-lg) 0 var(--spacing-sm) 0;">Key Features of Our CGPA Calculator</h2>
        <ul style="margin: 0; padding-left: var(--spacing-lg); color: var(--color-body); display: grid; gap: var(--spacing-xs);">
          <li><strong>Three tools, separate URLs:</strong> SGPA calculator, CGPA calculator and percentage calculator — each with its own page and shareable link.</li>
          <li><strong>Credits pre-filled:</strong> No need to look up credits. They are pre-filled for every subject, semester and branch.</li>
          <li><strong>Real-time recalculation:</strong> Results update instantly as you change grades.</li>
          <li><strong>Subject-wise, no rounding:</strong> Grade points are never rounded before the formula, so results stay exact.</li>
          <li><strong>Multi-semester support:</strong> Including lateral entry (skip semesters 1–2 with correct credit total).</li>
          <li><strong>Print and save:</strong> Print or save your result for your records.</li>
          <li><strong>Formula transparency:</strong> Every result shows the formula and a subject-wise breakdown.</li>
          <li><strong>Privacy:</strong> No personal data stored on a server. Calculations happen in your browser.</li>
          <li><strong>Target planner:</strong> "What SGPA do I need in remaining semesters to reach X CGPA?"</li>
          <li><strong>What-if / backlog simulator:</strong> Change a grade or clear an F and see the live effect.</li>
          <li><strong>Converters:</strong> Marks to grade point, CGPA to percentage, CGPA to 4.0 GPA, class/division.</li>
          <li><strong>AI features:</strong> Marks card scanner, plain-language assistant, study planner, result explainer, eligibility check, FAQ chatbot.</li>
        </ul>

        <h2 class="heading-md" style="margin: var(--spacing-lg) 0 var(--spacing-sm) 0;">How to Use the CGPA Calculator</h2>
        <ol style="margin: 0; padding-left: var(--spacing-lg); color: var(--color-body); display: grid; gap: var(--spacing-xs);">
          <li>Select your university and scheme (VTU 2022, 2021, 2018, 2025).</li>
          <li>Select your branch (CSE, ECE, ME, CE, EEE, ISE, etc.) and semester.</li>
          <li>Choose a grade for each subject — credits are already pre-filled.</li>
          <li>Your SGPA appears instantly. Switch semesters and repeat to build your full CGPA.</li>
          <li>Use the Target Planner to plan what you need in remaining semesters.</li>
          <li>Print or save your results.</li>
        </ol>

        <h2 class="heading-md" style="margin: var(--spacing-lg) 0 var(--spacing-sm) 0;">Frequently Asked Questions</h2>
        <div style="display: grid; gap: var(--spacing-md);">
          <div>
            <h3 class="heading-md" style="margin: 0 0 var(--spacing-xs) 0; font-size: var(--font-size-body-md);">What is the CGPA full form?</h3>
            <p class="body-sm" style="margin: 0;">CGPA full form is Cumulative Grade Point Average — the credit-weighted average of all your semester grade points.</p>
          </div>
          <div>
            <h3 class="heading-md" style="margin: 0 0 var(--spacing-xs) 0; font-size: var(--font-size-body-md);">How to convert CGPA to percentage?</h3>
            <p class="body-sm" style="margin: 0;">For VTU: Percentage = CGPA × 9.5. So a CGPA of 8.0 = 76%.</p>
          </div>
          <div>
            <h3 class="heading-md" style="margin: 0 0 var(--spacing-xs) 0; font-size: var(--font-size-body-md);">How to convert SGPA to CGPA?</h3>
            <p class="body-sm" style="margin: 0;">CGPA = (sum of all semester credit points) ÷ (sum of all credits). Use our SGPA to CGPA calculator for an exact result.</p>
          </div>
          <div>
            <h3 class="heading-md" style="margin: 0 0 var(--spacing-xs) 0; font-size: var(--font-size-body-md);">Is this CGPA calculator free?</h3>
            <p class="body-sm" style="margin: 0;">Yes, completely free. No account, no signup, no data stored. Unlimited use.</p>
          </div>
          <div>
            <h3 class="heading-md" style="margin: 0 0 var(--spacing-xs) 0; font-size: var(--font-size-body-md);">Which universities are supported?</h3>
            <p class="body-sm" style="margin: 0;">VTU is fully supported with pre-filled credits. Anna University, KTU, SRM, VIT, IPU and Saveetha are supported via the generic credit-weighted calculator. More universities are being added as data-only updates.</p>
          </div>
        </div>
      </article>
    </div>
  </section>

  {/* ===== SEO FAQ SECTION ===== */}
  <section class="section" style="background: var(--color-canvas);">
    <div class="container" style="max-width: 800px;">
      <h2 class="heading-lg" style="margin-bottom: var(--spacing-lg);">Frequently Asked Questions About CGPA Calculator</h2>
      <div style="display: grid; gap: var(--spacing-md);">
        <details class="feature-card" style="padding: var(--spacing-md);">
          <summary class="label-sm ink" style="cursor: pointer; font-weight: 600;">What is CGPA calculator?</summary>
          <p class="body-sm" style="margin-top: var(--spacing-sm);">A CGPA calculator is a free online tool that computes your Cumulative Grade Point Average. It takes your subjects, credits and grades for each semester and calculates your SGPA (Semester Grade Point Average) and overall CGPA. Our CGPA calculator is free, requires no signup, and supports VTU, Anna University, KTU, SRM, VIT, IPU and Saveetha with pre-filled credits.</p>
        </details>
        <details class="feature-card" style="padding: var(--spacing-md);">
          <summary class="label-sm ink" style="cursor: pointer; font-weight: 600;">How to calculate CGPA calculator?</summary>
          <p class="body-sm" style="margin-top: var(--spacing-sm);">To calculate CGPA: select your university and scheme, choose your branch and semester, enter your grade for each subject (credits are pre-filled), and the calculator instantly shows your SGPA. Repeat for all semesters, and the tool computes your overall CGPA as the credit-weighted average of all semester credit points divided by total credits.</p>
        </details>
        <details class="feature-card" style="padding: var(--spacing-md);">
          <summary class="label-sm ink" style="cursor: pointer; font-weight: 600;">How to CGPA calculator?</summary>
          <p class="body-sm" style="margin-top: var(--spacing-sm);">Using a CGPA calculator is simple: pick your university, select your scheme and branch, choose the semester, enter grades for each subject (credits are pre-filled), and your SGPA and CGPA are calculated in real time. No manual credit entry needed.</p>
        </details>
        <details class="feature-card" style="padding: var(--spacing-md);">
          <summary class="label-sm ink" style="cursor: pointer; font-weight: 600;">How to do CGPA to percentage calculator?</summary>
          <p class="body-sm" style="margin-top: var(--spacing-sm);">To convert CGPA to percentage, use the formula: Percentage = CGPA × 9.5 (for VTU). For example, a CGPA of 8.0 = 76%. Our CGPA to percentage converter does this instantly. Just enter your CGPA and get the percentage.</p>
        </details>
        <details class="feature-card" style="padding: var(--spacing-md);">
          <summary class="label-sm ink" style="cursor: pointer; font-weight: 600;">How to convert percentage to CGPA calculator?</summary>
          <p class="body-sm" style="margin-top: var(--spacing-sm);">To convert percentage to CGPA, divide your percentage by 9.5 (for VTU). For example, 76% ÷ 9.5 = 8.0 CGPA. Our percentage to CGPA calculator handles this conversion instantly.</p>
        </details>
        <details class="feature-card" style="padding: var(--spacing-md);">
          <summary class="label-sm ink" style="cursor: pointer; font-weight: 600;">How to CGPA to percentage calculator?</summary>
          <p class="body-sm" style="margin-top: var(--spacing-sm);">Enter your CGPA into our CGPA to percentage calculator. The tool multiplies your CGPA by 9.5 (VTU standard) and gives you the percentage. For other universities, the multiplier may differ.</p>
        </details>
        <details class="feature-card" style="padding: var(--spacing-md);">
          <summary class="label-sm ink" style="cursor: pointer; font-weight: 600;">How to convert CGPA to percentage calculator?</summary>
          <p class="body-sm" style="margin-top: var(--spacing-sm);">Use our CGPA to percentage converter. Enter your CGPA value and the tool applies the university-specific multiplier (9.5 for VTU) to give you the equivalent percentage. Results are instant and accurate.</p>
        </details>
        <details class="feature-card" style="padding: var(--spacing-md);">
          <summary class="label-sm ink" style="cursor: pointer; font-weight: 600;">How to calculate CGPA calculator?</summary>
          <p class="body-sm" style="margin-top: var(--spacing-sm);">Enter your grades for each subject across all semesters. The calculator computes credit points (credits × grade point) for each subject, sums them per semester for SGPA, then divides total credit points by total credits for CGPA. No manual math needed.</p>
        </details>
        <details class="feature-card" style="padding: var(--spacing-md);">
          <summary class="label-sm ink" style="cursor: pointer; font-weight: 600;">How to calculator CGPA for architecture?</summary>
          <p class="body-sm" style="margin-top: var(--spacing-sm);">For architecture programs, enter your subject grades and credits into the CGPA calculator. The formula is the same: CGPA = total credit points ÷ total credits. Our tool supports architecture branches — select your university, scheme and branch, then enter grades.</p>
        </details>
        <details class="feature-card" style="padding: var(--spacing-md);">
          <summary class="label-sm ink" style="cursor: pointer; font-weight: 600;">How to calculate CGPA in VTU?</summary>
          <p class="body-sm" style="margin-top: var(--spacing-sm);">In VTU, CGPA = (sum of all semester credit points) ÷ (sum of all credits). Each subject's credit points = credits × grade point (S=10, A=9, B=8, C=7, D=6, E=5, F=0). Use our VTU CGPA calculator — credits are pre-filled, you only enter grades.</p>
        </details>
        <details class="feature-card" style="padding: var(--spacing-md);">
          <summary class="label-sm ink" style="cursor: pointer; font-weight: 600;">How to convert CGPA to percentage in VTU?</summary>
          <p class="body-sm" style="margin-top: var(--spacing-sm);">VTU CGPA to percentage: Percentage = CGPA × 9.5. For example, CGPA 7.5 = 71.25%. Use our converter tool for instant conversion.</p>
        </details>
        <details class="feature-card" style="padding: var(--spacing-md);">
          <summary class="label-sm ink" style="cursor: pointer; font-weight: 600;">How to calculate VTU CGPA?</summary>
          <p class="body-sm" style="margin-top: var(--spacing-sm);">Enter your grades for each subject in each semester. The calculator computes SGPA per semester (credit-weighted), then CGPA across all semesters. Credits are pre-filled for VTU 2022, 2021, 2018 and 2025 schemes.</p>
        </details>
        <details class="feature-card" style="padding: var(--spacing-md);">
          <summary class="label-sm ink" style="cursor: pointer; font-weight: 600;">How CGPA is calculated in VTU?</summary>
          <p class="body-sm" style="margin-top: var(--spacing-sm);">CGPA in VTU is calculated as: total credit points across all semesters ÷ total credits across all semesters. Credit points per subject = credits × grade point. Lateral entry students skip semesters 1-2 in this calculation.</p>
        </details>
        <details class="feature-card" style="padding: var(--spacing-md);">
          <summary class="label-sm ink" style="cursor: pointer; font-weight: 600;">How is CGPA calculated in VTU?</summary>
          <p class="body-sm" style="margin-top: var(--spacing-sm);">CGPA = Σ(credits × grade point) ÷ Σ(credits) across all semesters. Each grade maps to a point: S=10, A=9, B=8, C=7, D=6, E=5, F=0. Our calculator does this automatically with pre-filled credits.</p>
        </details>
        <details class="feature-card" style="padding: var(--spacing-md);">
          <summary class="label-sm ink" style="cursor: pointer; font-weight: 600;">How to calculate CGPA in VTU 2022 scheme?</summary>
          <p class="body-sm" style="margin-top: var(--spacing-sm);">For VTU 2022 scheme: select "VTU 2022 Scheme", choose your branch (CSE, ECE, ME, etc.), pick each semester, enter grades. Credits are pre-filled per the 2022 scheme. The calculator shows SGPA per semester and cumulative CGPA.</p>
        </details>
        <details class="feature-card" style="padding: var(--spacing-md);">
          <summary class="label-sm ink" style="cursor: pointer; font-weight: 600;">How to calculate CGPA to percentage in VTU?</summary>
          <p class="body-sm" style="margin-top: var(--spacing-sm);">First calculate your CGPA using the VTU CGPA calculator, then multiply by 9.5 to get percentage. For example, CGPA 8.2 × 9.5 = 77.9%. Use our converter tool for instant results.</p>
        </details>
      </div>
    </div>
  </section>

  {/* FAQPage JSON-LD */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {"@type":"Question","name":"What is CGPA calculator?","acceptedAnswer":{"@type":"Answer","text":"A CGPA calculator is a free online tool that computes your Cumulative Grade Point Average. It takes your subjects, credits and grades for each semester and calculates your SGPA and overall CGPA. Our CGPA calculator is free, requires no signup, and supports VTU, Anna University, KTU, SRM, VIT, IPU and Saveetha with pre-filled credits."}},
