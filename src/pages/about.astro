---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About — CGPA Calculator AI" description="About CGPA Calculator AI: accurate, transparent SGPA, CGPA and Percentage calculators for VTU students. No personal data stored on a server." pathname="/about">
  <section class="section">
    <div class="container">
      <p class="eyebrow" style="margin: 0 0 var(--spacing-xs) 0;">About</p>
      <h1 class="heading-lg" style="margin-bottom: var(--spacing-lg);">About CGPA Calculator AI</h1>
      <p class="body-md" style="margin-bottom: var(--spacing-lg); max-width: 64ch;">
        CGPA Calculator AI helps Visvesvaraya Technological University (VTU) students calculate SGPA, CGPA and percentage transparently, in real time, with no personal data stored on a server.
      </p>
      <div class="feature-card" style="margin-bottom: var(--spacing-lg);">
        <h2 class="heading-md" style="margin: 0 0 var(--spacing-sm) 0;">Our commitments</h2>
        <ul style="margin: 0; padding-left: var(--spacing-lg); color: var(--color-text);">
          <li style="margin-bottom: var(--spacing-xs);"><strong>Accuracy:</strong> Subject-wise calculation with no rounding of grade points before the formula.</li>
          <li style="margin-bottom: var(--spacing-xs);"><strong>Transparency:</strong> Every result shows the formula and a subject-wise breakdown.</li>
          <li style="margin-bottom: var(--spacing-xs);"><strong>Privacy:</strong> No personal data is stored on a server. Calculations happen in your browser.</li>
          <li style="margin-bottom: var(--spacing-xs);"><strong>Free &amp; open:</strong> Unlimited use, no account required.</li>
        </ul>
      </div>
      <div class="feature-card">
        <h2 class="heading-md" style="margin: 0 0 var(--spacing-sm) 0;">Schemes supported</h2>
        <p class="body-sm" style="margin: 0;">VTU 2025, 2022, 2021 and 2018 schemes, with credits pre-filled for every subject, semester and branch.</p>
      </div>
    </div>
  </section>
</Layout>
