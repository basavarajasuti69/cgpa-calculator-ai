---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found — CGPA Calculator AI" description="The page you're looking for doesn't exist.">
  <section style="max-width: 640px; margin: 80px auto; text-align: center; display: grid; gap: 16px; padding: 0 16px;">
    <div style="font-size: 72px; font-weight: 800; line-height: 1; color: var(--color-primary);">404</div>
    <h1 style="margin: 0; font-size: 32px; color: var(--color-ink);">Page Not Found</h1>
    <p style="margin: 0; color: var(--color-body); font-size: 16px;">The page you're looking for doesn't exist or has been moved.</p>
    <div style="display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 12px;">
      <a href="/" style="padding: 10px 20px; background: var(--color-primary); color: #fff; text-decoration: none; border-radius: 8px; font-weight: 600;">Go Home</a>
      <a href="/universities" style="padding: 10px 20px; background: var(--color-surface); color: var(--color-ink); text-decoration: none; border: 1px solid var(--color-hairline); border-radius: 8px; font-weight: 600;">Browse Universities</a>
    </div>
  </section>
</Layout>
