---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Disclaimer — CGPA Calculator AI" description="Disclaimer: CGPA Calculator AI is not affiliated with VTU." pathname="/disclaimer" noAds>
  <section class="section">
    <div class="container" style="max-width: 720px;">
      <p class="eyebrow" style="margin: 0 0 var(--spacing-xs) 0;">Disclaimer</p>
      <h1 class="heading-lg" style="margin-bottom: var(--spacing-lg);">Disclaimer</h1>
      <div class="feature-card" style="margin-bottom: var(--spacing-lg);">
        <p class="body-md" style="margin: 0;">
          CGPA Calculator AI is <strong>not affiliated with Visvesvaraya Technological University (VTU)</strong>. It is an independent tool created for students.
        </p>
      </div>
      <p class="body-md" style="margin-bottom: var(--spacing-lg);">
        All grading rules, credits, and formulas are provided for guidance only and may not reflect official VTU circulars. Always verify with your college and the official VTU website before making academic decisions.
      </p>
      <p class="body-sm mute" style="margin: 0;">
        Official VTU: <a href="https://vtu.ac.in/" class="link-color" target="_blank" rel="noopener">vtu.ac.in</a>
      </p>
    </div>
  </section>
</Layout>
