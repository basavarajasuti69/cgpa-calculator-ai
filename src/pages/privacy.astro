---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy Policy — CGPA Calculator AI" description="Privacy Policy for CGPA Calculator AI. No personal data is stored on a server." pathname="/privacy" noAds>
  <section class="section">
    <div class="container" style="max-width: 720px;">
      <p class="eyebrow" style="margin: 0 0 var(--spacing-xs) 0;">Privacy</p>
      <h1 class="heading-lg" style="margin-bottom: var(--spacing-lg);">Privacy Policy</h1>
      <p class="body-md" style="margin-bottom: var(--spacing-lg);">
        CGPA Calculator AI does not collect, store, or transmit any personal data. Your grades, credits and calculation results never leave your browser.
      </p>
      <h2 class="heading-md" style="margin: var(--spacing-lg) 0 var(--spacing-sm) 0;">What we collect</h2>
      <p class="body-sm" style="margin-bottom: var(--spacing-sm);">Nothing. No name, email, roll number, or academic record is collected.</p>
      <h2 class="heading-md" style="margin: var(--spacing-lg) 0 var(--spacing-sm) 0;">Local storage</h2>
      <p class="body-sm" style="margin-bottom: var(--spacing-sm);">If you save progress, it is stored only in your browser's localStorage, on your device. We cannot access it.</p>
      <h2 class="heading-md" style="margin: var(--spacing-lg) 0 var(--spacing-sm) 0;">AI features</h2>
      <p class="body-sm" style="margin-bottom: var(--spacing-sm);">Optional AI features (marks-card scanner, assistant) process input temporarily to generate a response. No personal data is logged or retained.</p>
      <h2 class="heading-md" style="margin: var(--spacing-lg) 0 var(--spacing-sm) 0;">Third parties</h2>
      <p class="body-sm" style="margin-bottom: var(--spacing-sm);">No analytics, no tracking, no third-party scripts on the core calculators.</p>
    </div>
  </section>
</Layout>
