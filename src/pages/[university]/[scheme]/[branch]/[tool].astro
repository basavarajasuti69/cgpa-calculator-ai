---
import { SITE_URL } from "../../../../config/site";
import Layout from '../../../../layouts/Layout.astro';
import Calculator from '../../../../components/Calculator.astro';
import {
  getUniversity,
  getScheme,
  getVerifiedSchemes,
  getBranch,
  getUniversities,
} from '../../../../lib/data.ts';

export async function getStaticPaths() {
  const paths = [];
  for (const uni of getUniversities()) {
    for (const scheme of uni.schemes) {
      for (const branch of scheme.branches) {
        for (const tool of ['sgpa', 'cgpa', 'percentage']) {
          paths.push({
            params: { university: uni.id, scheme: scheme.id, branch: branch.id, tool },
            props: { university: uni.id, scheme: scheme.id, branch: branch.id, tool },
          });
        }
      }
    }
  }
  return paths;
}

const { university: uniId, scheme: schemeId, branch: branchId, tool } = Astro.props;
const uni = getUniversity(uniId);
const sc = uni && getScheme(uni, schemeId);
const br = sc && getBranch(sc, branchId);

if (!sc || !br || !['sgpa', 'cgpa', 'percentage'].includes(tool)) {
  return Astro.redirect(`/${uniId || 'vtu'}/${schemeId || '2022'}/${branchId || 'cse'}/sgpa`);
}

const branches = sc.branches.map(b => ({ id: b.id, short: b.short, name: b.name }));
const toolLabel = { sgpa: 'SGPA Calculator', cgpa: 'CGPA Calculator', percentage: 'CGPA to Percentage Calculator' }[tool];

const firstSem = br.semesters[0];

const title = `${br.short} ${toolLabel} — All Semesters — VTU ${sc.name}`;
const prefilled = uni.id === 'vtu' ? 'VTU credits are pre-filled per scheme.' : 'Add your own subjects and credits in manual mode.';
const description = `Calculate ${toolLabel.toLowerCase()} for {br.name} all semesters (${sc.name}) at ${uni.name}. ${prefilled} Free, accurate, real-time results.`;

const semesters = br.semesters.map((s) => ({
  semester: s.semester,
  name: s.name,
  subjects: s.subjects.map((sub) => ({ code: sub.code, name: sub.name, credits: sub.credits, type: sub.type })),
}));

const breadcrumb = [
  { label: 'VTU', href: '/universities' },
  { label: sc.name, href: `/vtu/${schemeId}` },
  { label: br.name, href: `/vtu/${schemeId}/${branchId}` },
  { label: firstSem.name, href: `/vtu/${schemeId}/${branchId}/${firstSem.semester}/${tool}` },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumb.map((b, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": b.label,
        "item": SITE_URL + b.href,
      })),
    },
    {
      "@type": "SoftwareApplication",
      "name": `${br.short} ${tool.toUpperCase()} Calculator`,
      "applicationCategory": "Education",
      "applicationSubCategory": "Calculator",
      "operatingSystem": "Web",
      "url": SITE_URL + "/vtu/" + schemeId + "/" + branchId + "/" + tool + "/",
      "description": description,
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "audience": { "@type": "Audience", "audienceType": "University students" },
    },
  ],
};
---


<Layout title={title} description={description} pathname={Astro.url.pathname}>
  <section class="calc-page">
    <div class="container calc-shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb" style="margin-bottom: 12px;">
        <ol class="breadcrumb-list" style="display:flex; gap:6px; flex-wrap:wrap; list-style:none; padding:0; margin:0; font-size:13px; color:var(--color-text-muted);">
          <li style="display:inline-flex; align-items:center;"><a href="/universities" style="color:var(--color-link); text-decoration:none; font-weight:600;">VTU</a></li>
          <li style="display:inline-flex; align-items:center;"><span style="margin:0 6px; color:var(--color-text-muted);">›</span><a href={`/vtu/${schemeId}`} style="color:var(--color-link); text-decoration:none; font-weight:600;">{sc.name}</a></li>
          <li style="display:inline-flex; align-items:center;"><span style="margin:0 6px; color:var(--color-text-muted);">›</span><a href={`/vtu/${schemeId}/${branchId}`} style="color:var(--color-link); text-decoration:none; font-weight:600;">{br.name}</a></li>
          <li style="display:inline-flex; align-items:center;"><span style="margin:0 6px; color:var(--color-text-muted);">›</span><span style="color:var(--color-text-strong); font-weight:600;">{toolLabel}</span></li>
        </ol>
      </nav>

      <div>
        <a href="/" class="body-sm" style="font-weight:700;">← Home</a>
        <p class="eyebrow" style="margin: 10px 0 6px;">{uni.name} · {sc.name}</p>
        <h1 class="heading-lg">{br.short} {toolLabel} — All Semesters</h1>
        <p class="body-md" style="margin: 8px 0 0; max-width: 56ch;">Choose a semester to calculate {toolLabel.toLowerCase()} for {br.name}. Credits are pre-filled from the official VTU {sc.name} scheme. Results update live as you tap grades.</p>

        <div style="margin-top: 24px; display:grid; gap: 10px;">
          {br.semesters.map((s) => (
            <a href={`/vtu/${schemeId}/${branchId}/${s.semester}/${tool}`} class="button-primary" style="text-align:left; padding: 12px 16px; text-decoration: none;">
              <span style="font-weight:700;">{s.name}</span> <span style="color:var(--color-text-muted); font-weight:400;">· {s.subjects.reduce((a,b)=>a+b.credits,0)} cr</span>
            </a>
          ))}
        </div>

        <div class="related-links" style="margin-top: 32px; display:grid; gap: 8px;">
          <div style="font-size: 12px; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px;">Related calculators</div>
          <a href={`/vtu/${schemeId}/${branchId}/${firstSem.semester}/cgpa`} style="color: var(--color-link); text-decoration: none; font-weight: 600;">{br.short} CGPA Calculator</a>
          <a href={`/vtu/${schemeId}/${branchId}/${firstSem.semester}/percentage`} style="color: var(--color-link); text-decoration: none; font-weight: 600;">CGPA → Percentage Converter</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
