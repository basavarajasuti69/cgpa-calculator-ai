---
import { SITE_URL } from "../../../../../config/site";
import Layout from '../../../../../layouts/Layout.astro';
import Calculator from '../../../../../components/Calculator.astro';
import { getUniversity, getScheme, getBranch, getUniversities } from '../../../../../lib/data.ts';

export async function getStaticPaths() {
  const paths = [];
  for (const uni of getUniversities()) {
    if (uni.id !== 'vtu') continue;
    for (const scheme of uni.schemes) {
      for (const branch of scheme.branches) {
        for (const sem of branch.semesters) {
          for (const tool of ['sgpa', 'cgpa', 'percentage']) {
            paths.push({
              params: {
                university: uni.id,
                scheme: scheme.id,
                branch: branch.id,
                semester: String(sem.semester),
                tool,
              },
              props: {
                university: uni.id,
                scheme: scheme.id,
                branch: branch.id,
                semester: String(sem.semester),
                tool,
              },
            });
          }
        }
      }
    }
  }
  return paths;
}

const { university: uniId, scheme: schemeId, branch: branchId, semester: semParam, tool } = Astro.props;
const uni = getUniversity(uniId);
const sc = uni && getScheme(uni, schemeId);
const br = sc && getBranch(sc, branchId);
const semNum = parseInt(semParam, 10) || 1;
const sem = br && br.semesters.find((s) => s.semester === semNum);

if (!sc || !br || !sem || !['sgpa', 'cgpa', 'percentage'].includes(tool)) {
  return Astro.redirect(`/vtu/${schemeId || '2022'}/${branchId || 'cse'}/1/sgpa`);
}

const branches = sc.branches.map(b => ({ id: b.id, short: b.short, name: b.name }));
const creditTotal = sem.subjects.reduce((a, b) => a + b.credits, 0);

const semesters = [sem];
const semIndex = br.semesters.findIndex((s) => s.semester === semNum);
const prevSem = semIndex > 0 ? br.semesters[semIndex - 1] : null;
const nextSem = semIndex < br.semesters.length - 1 ? br.semesters[semIndex + 1] : null;

const toolLabel = { sgpa: 'SGPA Calculator', cgpa: 'CGPA Calculator', percentage: 'CGPA to Percentage Calculator' }[tool];
const title = `${br.short} ${toolLabel} — ${sem.name} — VTU ${sc.name}`;
const description = `Calculate ${toolLabel.toLowerCase()} for ${br.name} ${sem.name} (${sc.name}) at ${uni.name}. Subjects and credits pre-filled from the official VTU ${sc.name} scheme. Free, accurate, real-time results.`;

const breadcrumb = [
  { label: 'VTU', href: '/universities' },
  { label: sc.name, href: `/vtu/${schemeId}` },
  { label: br.name, href: `/vtu/${schemeId}/${branchId}` },
  { label: sem.name, href: `/vtu/${schemeId}/${branchId}/${semNum}/${tool}` },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumb.map((b, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": b.label,
        "item": SITE_URL + b.href,
      })),
    },
    {
      "@type": "SoftwareApplication",
      "name": `${br.short} ${toolLabel}`,
      "applicationCategory": "Education",
      "applicationSubCategory": "Calculator",
      "operatingSystem": "Web",
      "url": SITE_URL + "/vtu/" + schemeId + "/" + branchId + "/" + semNum + "/" + tool + "/",
      "description": description,
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "audience": { "@type": "Audience", "audienceType": "University students" },
    },
  ],
};
---
<Layout title={title} description={description} pathname={Astro.url.pathname}>
  <section class="calc-page">
    <div class="container calc-shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb" style="margin-bottom: 12px;">
        <ol class="breadcrumb-list" style="display:flex; gap:6px; flex-wrap:wrap; list-style:none; padding:0; margin:0; font-size:13px; color:var(--color-text-muted);">
          {breadcrumb.map((b, i) => (
            <li style="display:inline-flex; align-items:center;">
              {i > 0 && <span style="margin-right:6px; color:var(--color-text-muted);">›</span>}
              <a href={b.href} style="color:var(--color-link); text-decoration:none; font-weight:600;">{b.label}</a>
            </li>
          ))}
        </ol>
      </nav>

      <div>
        <a href="/" class="body-sm" style="font-weight:700;">← Home</a>
        <p class="eyebrow" style="margin: 10px 0 6px;">{uni.name} · {sc.name}</p>
        <h1 class="heading-lg">{br.short} {toolLabel} — {sem.name}</h1>
        <p class="body-md" style="margin: 8px 0 0; max-width: 56ch;">Tap grades on a marks-card layout. Credits stay filled per the VTU {sc.name}. Your class (distinction / first / second) updates live. Semester credit total: {creditTotal} cr.</p>

      <Calculator
        uniId={uniId}
        schemeId={schemeId}
        branchId={branchId}
        branches={branches}
        tool={tool}
        semesters={semesters}
        gradeTable={sc.gradeTable}
        cgpaToPercentage={sc.cgpaToPercentage}
        lateralEntry={sc.lateralEntry}
        excludedGradeLetters={sc.excludedGradeLetters ?? []}
        cgpaFormulaNote={sc.cgpaFormulaNote ?? null}
        classThresholds={sc.classThresholds ?? []}
        isDraft={sc.status === 'draft'}
      />
      </div>

      <section class="seo-content" style="margin-top: 40px; padding: 24px; border: 1px solid var(--color-border); background: var(--color-surface-card);">
        <h2 style="font-size: 18px; margin-top: 0;">{br.short} {toolLabel} — {sem.name} — VTU {sc.name}</h2>
        <p style="margin: 8px 0 16px; color: var(--color-text);">
          This calculator helps {br.name} students at {uni.name} compute their {toolLabel.toLowerCase()} for {sem.name} under the {sc.name}. Credits are pre-filled from the official VTU scheme. Select your grade for each course and the result updates instantly.
        </p>

        <div class="formula-box" style="margin: 20px 0; padding: 16px; border-radius: 8px; border: 1px solid var(--color-border);">
          <div style="font-size: 13px; color: var(--color-text-muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.06em;">Formula</div>
          <div style="font-family: var(--font-family-mono); font-size: 14px; color: var(--color-primary);">
            {tool === 'sgpa' ? 'SGPA = Σ (credits × grade point) ÷ Σ credits' : tool === 'cgpa' ? 'CGPA = Σ (credit points) ÷ Σ (credits)' : 'Percentage = CGPA × 10'}
          </div>
          {sc.cgpaFormulaNote && (
            <p style="font-size: 12px; color: var(--color-text-muted); margin-top: 8px;">{sc.cgpaFormulaNote}</p>
          )}
        </div>

        <h3 style="font-size: 16px; margin: 24px 0 12px;">Frequently Asked Questions</h3>
        <div class="faqs" style="display:grid; gap: 12px;">
          <div style="border-bottom: 1px solid var(--color-border); padding-bottom: 8px;">
            <div style="font-weight: 600; color: var(--color-text-strong);">Does F count in the SGPA denominator?</div>
            <div style="font-size: 13px; color: var(--color-text-muted); margin-top: 4px;">Yes. Under VTU rules, F and Absent grades earn 0 grade points but their credits remain in the SGPA denominator until the course is cleared.</div>
          </div>
          <div style="border-bottom: 1px solid var(--color-border); padding-bottom: 8px;">
            <div style="font-weight: 600; color: var(--color-text-strong);">What is the credit total for {sem.name}?</div>
            <div style="font-size: 13px; color: var(--color-text-muted); margin-top: 4px;">{sem.name} under the VTU {sc.name} carries {creditTotal} credits.</div>
          </div>
          <div style="border-bottom: 1px solid var(--color-border); padding-bottom: 8px;">
            <div style="font-weight: 600; color: var(--color-text-strong);">How is percentage calculated from CGPA?</div>
            <div style="font-size: 13px; color: var(--color-text-muted); margin-top: 4px;">VTU uses Percentage = CGPA × 10. For example, a CGPA of 8.20 equals 82.0%. Some schemes may use alternative formulas — check with your college.</div>
          </div>
          <div style="border-bottom: 1px solid var(--color-border); padding-bottom: 8px;">
            <div style="font-weight: 600; color: var(--color-text-strong);">Can I calculate CGPA across multiple semesters?</div>
            <div style="font-size: 13px; color: var(--color-text-muted); margin-top: 4px;">Yes. Switch to the CGPA tab and enter each semester's SGPA. Lateral entry students can skip the first two semesters.</div>
          </div>
          <div style="border-bottom: 1px solid var(--color-border); padding-bottom: 8px;">
            <div style="font-weight: 600; color: var(--color-text-strong);">Is this official VTU data?</div>
            <div style="font-size: 13px; color: var(--color-text-muted); margin-top: 4px;">Subject data follows the VTU {sc.name} scheme. Grade and percentage rules reflect verified VTU regulations.</div>
          </div>
        </div>

        <div class="related-links" style="margin-top: 24px; display:grid; gap: 8px;">
          <div style="font-size: 12px; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px;">Related calculators</div>
          {prevSem && (
            <a href={`/vtu/${schemeId}/${branchId}/${prevSem.semester}/${tool}`} style="color: var(--color-link); text-decoration: none; font-weight: 600;">← {prevSem.name} {toolLabel}</a>
          )}
          <a href={`/vtu/${schemeId}/${branchId}/${semNum}/cgpa`} style="color: var(--color-link); text-decoration: none; font-weight: 600;">{br.short} CGPA Calculator</a>
          <a href={`/vtu/${schemeId}/${branchId}/${semNum}/percentage`} style="color: var(--color-link); text-decoration: none; font-weight: 600;">CGPA → Percentage Converter</a>
          {nextSem && (
            <a href={`/vtu/${schemeId}/${branchId}/${nextSem.semester}/${tool}`} style="color: var(--color-link); text-decoration: none; font-weight: 600;">{nextSem.name} {toolLabel} →</a>
          )}
        </div>
      </section>

      {tool === 'sgpa' && (
        <section class="section" style="padding-top: 16px;">
          <div class="container">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 12px;">
              <p class="eyebrow">My saved results</p>
              <span class="body-sm mute">Stored in your browser only</span>
            </div>
            <div id="saved-sgpa-results" class="my-results-list" style="margin-top:12px;"></div>
          </div>
        </section>
      )}
      {tool === 'cgpa' && (
        <section class="section" style="padding-top: 16px;">
          <div class="container">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 12px;">
              <p class="eyebrow">My saved results</p>
              <span class="body-sm mute">Stored in your browser only</span>
            </div>
            <div id="saved-cgpa-results" class="my-results-list" style="margin-top:12px;"></div>
          </div>
        </section>
      )}
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
</Layout>
