---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — CGPA Calculator AI" description="Contact CGPA Calculator AI. Feedback, questions and support for the VTU SGPA, CGPA and Percentage calculators." pathname="/contact">
  <section class="section">
    <div class="container" style="max-width: 640px;">
      <p class="eyebrow" style="margin: 0 0 var(--spacing-xs) 0;">Contact</p>
      <h1 class="heading-lg" style="margin-bottom: var(--spacing-lg);">Get in touch</h1>
      <p class="body-md" style="margin-bottom: var(--spacing-lg); max-width: 60ch;">
        Have feedback, a question about a calculation, or want to report a bug? Reach out. We respond to every message.
      </p>
      <div class="feature-card">
        <h2 class="heading-md" style="margin: 0 0 var(--spacing-sm) 0;">Email</h2>
        <p class="body-sm" style="margin: 0;"><a href="mailto:support@cgpacalculatorai.com" class="link-color">support@cgpacalculatorai.com</a></p>
      </div>
      <div class="feature-card" style="margin-top: var(--spacing-lg);">
        <h2 class="heading-md" style="margin: 0 0 var(--spacing-sm) 0;">Social</h2>
        <p class="body-sm" style="margin: 0;">Follow us for VTU updates and calculator tips.</p>
        <div style="display: flex; gap: var(--spacing-sm); margin-top: var(--spacing-sm);">
          <a href="https://instagram.com" class="button-ghost-sm" target="_blank" rel="noopener">Instagram</a>
          <a href="https://twitter.com" class="button-ghost-sm" target="_blank" rel="noopener">Twitter</a>
          <a href="https://facebook.com" class="button-ghost-sm" target="_blank" rel="noopener">Facebook</a>
          <a href="https://linkedin.com" class="button-ghost-sm" target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
