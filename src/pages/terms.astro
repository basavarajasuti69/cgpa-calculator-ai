---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Terms of Service — CGPA Calculator AI" description="Terms of Service for CGPA Calculator AI." pathname="/terms" noAds>
  <section class="section">
    <div class="container" style="max-width: 720px;">
      <p class="eyebrow" style="margin: 0 0 var(--spacing-xs) 0;">Terms</p>
      <h1 class="heading-lg" style="margin-bottom: var(--spacing-lg);">Terms of Service</h1>
      <p class="body-md" style="margin-bottom: var(--spacing-lg);">
        By using CGPA Calculator AI you agree to these terms. The service is provided free of charge, with no account required.
      </p>
      <h2 class="heading-md" style="margin: var(--spacing-lg) 0 var(--spacing-sm) 0;">Use of the calculators</h2>
      <p class="body-sm" style="margin-bottom: var(--spacing-sm);">The calculators are for educational guidance only. Results are computed from the grades and credits you enter.</p>
      <h2 class="heading-md" style="margin: var(--spacing-lg) 0 var(--spacing-sm) 0;">AI output</h2>
      <p class="body-sm" style="margin-bottom: var(--spacing-sm);">AI-generated content (explanations, plans, eligibility checks) is guidance only, not an official result, and never overrides the calculator output.</p>
      <h2 class="heading-md" style="margin: var(--spacing-lg) 0 var(--spacing-sm) 0;">No warranty</h2>
      <p class="body-sm" style="margin-bottom: var(--spacing-sm);">The service is provided "as is" without warranty. Always verify results with your college and official VTU sources.</p>
    </div>
  </section>
</Layout>
