---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
---
<Layout title="Server Error — CGPA Calculator AI" description="Something went wrong on our end." pathname="/500">
  <section style="max-width: 640px; margin: 80px auto; text-align: center; display: grid; gap: 16px; padding: 0 16px;">
    <div style="font-size: 72px; font-weight: 800; line-height: 1; color: var(--color-primary);">500</div>
    <h1 style="margin: 0; font-size: 32px; color: var(--color-text-strong);">Server Error</h1>
    <p style="margin: 0; color: var(--color-text); font-size: 16px;">Something went wrong on our end. Please try again later.</p>
    <div style="display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 12px;">
      <a href="/" style="padding: 10px 20px; background: var(--color-primary); color: #fff; text-decoration: none; border-radius: 8px; font-weight: 600;">Go Home</a>
      <a href="javascript:location.reload()" style="padding: 10px 20px; background: var(--color-surface); color: var(--color-text-strong); text-decoration: none; border: 1px solid var(--color-border); border-radius: 8px; font-weight: 600;">Reload Page</a>
    </div>
  </section>
</Layout>
