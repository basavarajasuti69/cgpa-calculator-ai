---
import Layout from '../../../layouts/Layout.astro';
import { getUSInstitution, usInstitutions } from '../../../data/us';

export function getStaticPaths() {
  return usInstitutions.filter((u:any)=>u.id!=='standard-4').map((u:any)=>({ params: { school: u.id } }));
}

const { school } = Astro.params;
const inst = getUSInstitution(school as string);
---

<Layout title={`${inst?.name || school} GPA Calculator | CGPA Calculator AI`} description={`${inst?.name} grading and GPA calculator. Rules from official sources where available.`} pathname={`/us/${school}/gpa-calculator`}>
  <section class="section">
    <div class="container" style="max-width: 800px;">
      <p class="eyebrow" style="margin: 0 0 var(--spacing-xs) 0;">USA • {inst?.name}</p>
      <h1 class="heading-lg" style="margin-bottom: 12px;">{inst?.name} GPA Calculator</h1>
      {inst?.status !== 'verified' && <div class="feature-card" style="padding:12px 16px; margin-bottom:16px; border:1px solid var(--color-border);"><strong>Note:</strong> {inst?.status === 'no official GPA' ? 'No official GPA published. This is an unofficial estimate using the standard 4.0 scale.' : 'Draft: not verified yet. Use generic calculator.'}</div>}
      {inst?.sources && <p class="body-sm" style="margin-bottom:16px; color:var(--color-text-muted);">Sources: {inst.sources.map((s:any)=><a href={s.url}>{s.title}</a>)} • Last verified: {inst.lastVerified}</p>}
      {inst?.gradeTable && inst.gradeTable.length > 0 && <div class="feature-card" style="padding: var(--spacing-lg); margin-bottom:16px;"><h2 style="margin:0 0 12px 0;">Grading Table</h2><div style="display:grid; grid-template-columns:1fr 1fr; gap:6px;">{inst.gradeTable.map((g:any)=><div style="display:flex; justify-content:space-between;"><span>{g.grade}</span><span>{g.points}</span></div>)}</div></div>}
      {inst?.notes && <p class="body-sm" style="color:var(--color-text);">{inst.notes}</p>}
      <p class="body-sm" style="margin-top:12px; color:var(--color-text-muted);">Not affiliated with or endorsed by {inst?.name}; names are used only to describe grading rules.</p>
    </div>
  </section>
</Layout>
