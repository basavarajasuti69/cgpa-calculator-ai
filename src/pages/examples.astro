---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Worked Examples — CGPA Calculator AI" description="Verified SGPA, CGPA and lateral entry worked examples with correct arithmetic." pathname="/examples">
  <section class="section">
    <div class="container" style="max-width: 720px;">
      <p class="eyebrow" style="margin: 0 0 var(--spacing-xs) 0;">Examples</p>
      <h1 class="heading-lg" style="margin-bottom: var(--spacing-lg);">Worked Examples</h1>
      <p class="body-sm mute" style="margin-bottom: var(--spacing-lg);">
        All arithmetic verified. Credit points = credits × grade point; SGPA = total points ÷ total credits.
      </p>

      <div class="feature-card" style="margin-bottom: var(--spacing-lg);">
        <h2 class="heading-md" style="margin: 0 0 var(--spacing-sm) 0;">SGPA example — one semester</h2>
        <table style="width: 100%; border-collapse: collapse; font-size: var(--font-size-body-sm); margin-bottom: var(--spacing-sm);">
          <thead>
            <tr style="text-align: left;">
              <th style="padding: var(--spacing-xs); border-bottom: 1px solid var(--color-hairline); color: var(--color-mute);">Subject</th>
              <th style="padding: var(--spacing-xs); border-bottom: 1px solid var(--color-hairline); color: var(--color-mute); text-align: right;">Credits</th>
              <th style="padding: var(--spacing-xs); border-bottom: 1px solid var(--color-hairline); color: var(--color-mute); text-align: right;">Grade</th>
              <th style="padding: var(--spacing-xs); border-bottom: 1px solid var(--color-hairline); color: var(--color-mute); text-align: right;">GP</th>
              <th style="padding: var(--spacing-xs); border-bottom: 1px solid var(--color-hairline); color: var(--color-mute); text-align: right;">Credit points</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: var(--spacing-xs); font-family: var(--font-family-mono);">XX11</td>
              <td style="padding: var(--spacing-xs); text-align: right;">3</td>
              <td style="padding: var(--spacing-xs); text-align: right;">B</td>
              <td style="padding: var(--spacing-xs); text-align: right;">8</td>
              <td style="padding: var(--spacing-xs); text-align: right;">24</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: var(--spacing-xs); font-family: var(--font-family-mono);">XX12</td>
              <td style="padding: var(--spacing-xs); text-align: right;">3</td>
              <td style="padding: var(--spacing-xs); text-align: right;">Absent</td>
              <td style="padding: var(--spacing-xs); text-align: right;">0</td>
              <td style="padding: var(--spacing-xs); text-align: right;">0</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: var(--spacing-xs); font-family: var(--font-family-mono);">XX13</td>
              <td style="padding: var(--spacing-xs); text-align: right;">3</td>
              <td style="padding: var(--spacing-xs); text-align: right;">A</td>
              <td style="padding: var(--spacing-xs); text-align: right;">9</td>
              <td style="padding: var(--spacing-xs); text-align: right;">27</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: var(--spacing-xs); font-family: var(--font-family-mono);">XX14</td>
              <td style="padding: var(--spacing-xs); text-align: right;">3</td>
              <td style="padding: var(--spacing-xs); text-align: right;">F</td>
              <td style="padding: var(--spacing-xs); text-align: right;">0</td>
              <td style="padding: var(--spacing-xs); text-align: right;">0</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: var(--spacing-xs); font-family: var(--font-family-mono);">XX15</td>
              <td style="padding: var(--spacing-xs); text-align: right;">3</td>
              <td style="padding: var(--spacing-xs); text-align: right;">D</td>
              <td style="padding: var(--spacing-xs); text-align: right;">6</td>
              <td style="padding: var(--spacing-xs); text-align: right;">18</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: var(--spacing-xs); font-family: var(--font-family-mono);">XX16</td>
              <td style="padding: var(--spacing-xs); text-align: right;">1</td>
              <td style="padding: var(--spacing-xs); text-align: right;">E</td>
              <td style="padding: var(--spacing-xs); text-align: right;">5</td>
              <td style="padding: var(--spacing-xs); text-align: right;">5</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: var(--spacing-xs); font-family: var(--font-family-mono);">XX17</td>
              <td style="padding: var(--spacing-xs); text-align: right;">1</td>
              <td style="padding: var(--spacing-xs); text-align: right;">A</td>
              <td style="padding: var(--spacing-xs); text-align: right;">9</td>
              <td style="padding: var(--spacing-xs); text-align: right;">9</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: var(--spacing-xs); font-family: var(--font-family-mono);">XX18</td>
              <td style="padding: var(--spacing-xs); text-align: right;">2</td>
              <td style="padding: var(--spacing-xs); text-align: right;">D</td>
              <td style="padding: var(--spacing-xs); text-align: right;">6</td>
              <td style="padding: var(--spacing-xs); text-align: right;">12</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: var(--spacing-xs); font-family: var(--font-family-mono);">XX19</td>
              <td style="padding: var(--spacing-xs); text-align: right;">1</td>
              <td style="padding: var(--spacing-xs); text-align: right;">D</td>
              <td style="padding: var(--spacing-xs); text-align: right;">6</td>
              <td style="padding: var(--spacing-xs); text-align: right;">6</td>
            </tr>
            <tr style="border-top: 2px solid var(--color-ink);">
              <td style="padding: var(--spacing-xs); font-weight: 600; color: var(--color-ink);">Total</td>
              <td style="padding: var(--spacing-xs); text-align: right; font-weight: 600; color: var(--color-ink);">20</td>
              <td style="padding: var(--spacing-xs);" />
              <td style="padding: var(--spacing-xs);" />
              <td style="padding: var(--spacing-xs); text-align: right; font-weight: 600; color: var(--color-ink);">101</td>
            </tr>
          </tbody>
        </table>
        <div class="code-block">
          <div class="body-sm mute">SGPA = 101 ÷ 20 = 5.05</div>
        </div>
      </div>

      <div class="feature-card" style="margin-bottom: var(--spacing-lg);">
        <h2 class="heading-md" style="margin: 0 0 var(--spacing-sm) 0;">CGPA example — full program (8 semesters)</h2>
        <table style="width: 100%; border-collapse: collapse; font-size: var(--font-size-body-sm); margin-bottom: var(--spacing-sm);">
          <thead>
            <tr style="text-align: left;">
              <th style="padding: var(--spacing-xs); border-bottom: 1px solid var(--color-hairline); color: var(--color-mute);">Semester</th>
              <th style="padding: var(--spacing-xs); border-bottom: 1px solid var(--color-hairline); color: var(--color-mute); text-align: right;">Credits</th>
              <th style="padding: var(--spacing-xs); border-bottom: 1px solid var(--color-hairline); color: var(--color-mute); text-align: right;">SGPA</th>
              <th style="padding: var(--spacing-xs); border-bottom: 1px solid var(--color-hairline); color: var(--color-mute); text-align: right;">Credit points</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: var(--spacing-xs); font-family: var(--font-family-mono);">I</td>
              <td style="padding: var(--spacing-xs); text-align: right;">20</td>
              <td style="padding: var(--spacing-xs); text-align: right;">5.00</td>
              <td style="padding: var(--spacing-xs); text-align: right;">100</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: var(--spacing-xs); font-family: var(--font-family-mono);">II</td>
              <td style="padding: var(--spacing-xs); text-align: right;">20</td>
              <td style="padding: var(--spacing-xs); text-align: right;">6.70</td>
              <td style="padding: var(--spacing-xs); text-align: right;">134</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: var(--spacing-xs); font-family: var(--font-family-mono);">III</td>
              <td style="padding: var(--spacing-xs); text-align: right;">20</td>
              <td style="padding: var(--spacing-xs); text-align: right;">9.20</td>
              <td style="padding: var(--spacing-xs); text-align: right;">184</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: var(--spacing-xs); font-family: var(--font-family-mono);">IV</td>
              <td style="padding: var(--spacing-xs); text-align: right;">20</td>
              <td style="padding: var(--spacing-xs); text-align: right;">6.85</td>
              <td style="padding: var(--spacing-xs); text-align: right;">137</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: var(--spacing-xs); font-family: var(--font-family-mono);">V</td>
              <td style="padding: var(--spacing-xs); text-align: right;">20</td>
              <td style="padding: var(--spacing-xs); text-align: right;">8.20</td>
              <td style="padding: var(--spacing-xs); text-align: right;">164</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: var(--spacing-xs); font-family: var(--font-family-mono);">VI</td>
              <td style="padding: var(--spacing-xs); text-align: right;">20</td>
              <td style="padding: var(--spacing-xs); text-align: right;">7.75</td>
              <td style="padding: var(--spacing-xs); text-align: right;">155</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: var(--spacing-xs); font-family: var(--font-family-mono);">VII</td>
              <td style="padding: var(--spacing-xs); text-align: right;">24</td>
              <td style="padding: var(--spacing-xs); text-align: right;">9.21</td>
              <td style="padding: var(--spacing-xs); text-align: right;">221</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline-soft);">
              <td style="padding: var(--spacing-xs); font-family: var(--font-family-mono);">VIII</td>
              <td style="padding: var(--spacing-xs); text-align: right;">16</td>
              <td style="padding: var(--spacing-xs); text-align: right;">9.25</td>
              <td style="padding: var(--spacing-xs); text-align: right;">148</td>
            </tr>
            <tr style="border-top: 2px solid var(--color-ink);">
              <td style="padding: var(--spacing-xs); font-weight: 600; color: var(--color-ink);">Total</td>
              <td style="padding: var(--spacing-xs); text-align: right; font-weight: 600; color: var(--color-ink);">160</td>
              <td style="padding: var(--spacing-xs);" />
              <td style="padding: var(--spacing-xs); text-align: right; font-weight: 600; color: var(--color-ink);">1243</td>
            </tr>
          </tbody>
        </table>
        <div class="code-block">
          <div class="body-sm mute">CGPA = 1243 ÷ 160 = 7.77</div>
        </div>
      </div>

      <div class="feature-card">
        <h2 class="heading-md" style="margin: 0 0 var(--spacing-sm) 0;">Lateral entry example (skip semesters 1–2)</h2>
        <p class="body-sm" style="margin-bottom: var(--spacing-sm);">Lateral-entry students skip semesters I and II. Correct credit total excludes those semesters.</p>
        <div class="code-block">
          <div class="body-sm mute">Credits considered = 160 − 20 − 20 = 120</div>
          <div class="body-sm mute">Credit points considered = 1243 − 100 − 134 = 1009</div>
          <div class="body-sm mute" style="margin-top: var(--spacing-xs);">CGPA = 1009 ÷ 120 = 8.41</div>
        </div>
      </div>
    </div>
  </section>
</Layout>
