    font-weight: 800;
  }
  .score-meta { display: grid; gap: 6px; color: var(--color-text-muted); font-size: 14px; text-align: right; }
  .score-meta strong { color: var(--color-text-strong); }
  .calc-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .marks-input {
    text-align: center;
    font-weight: 700;
    padding: 8px 10px;
  }
  .marksheet-head > div:first-child {
    display: flex;
