---
const { schemeId, branchId, uniId = 'vtu', branches = [], tool = 'sgpa', semesters = [], gradeTable = [], cgpaToPercentage = { multiplier: 10 }, lateralEntry = { skipFirstNSemesters: 2 }, excludedGradeLetters = [], cgpaFormulaNote = null, classThresholds = [], isDraft = false } = Astro.props;

const gradeJson = JSON.stringify(gradeTable);
const semestersJson = JSON.stringify(semesters);
const branchesJson = JSON.stringify(branches.map(b => ({ id: b.id, short: b.short })));
const cgpaConfigJson = JSON.stringify({ cgpaToPercentage, lateralEntry, excludedGradeLetters, cgpaFormulaNote });
const pathBase = branchId ? `/${uniId}/${schemeId}/${branchId}` : `/${uniId}/${schemeId}`;
---

<section id="calculator" aria-label="CGPA calculator" class="calc-root"
  data-grade-table={gradeJson}
  data-semesters={semestersJson}
  data-scheme={schemeId}
  data-branch={branchId}
  data-uni-id={uniId}
  data-branches={branchesJson}
  data-tool={tool}
  data-cgpa-config={cgpaConfigJson}
  data-excluded-grades={JSON.stringify(excludedGradeLetters)}
  data-cgpa-formula-note={cgpaFormulaNote ?? ''}
  data-class-thresholds={JSON.stringify(classThresholds)}
  data-is-draft={isDraft}>

  {isDraft && (
    <div style="padding: 14px 18px; margin-bottom: 16px; background: #fff3cd; border: 1px solid #b08a00; color: #664d00; font-size: 13px; border-radius: 6px;">
      <strong style="display:block; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.06em;">Draft — verify with your official regulation</strong>
      This scheme's grade table, percentage formula, and class rules are pending confirmation from the university's official regulation document. Results are indicative only — do not rely on them for academic decisions without checking your official grade card and the university website.
    </div>
  )}

  <div class="calc-toolbar">
    <div>
      <label class="field-label" for="scheme-select">Scheme</label>
      <select id="scheme-select" class="select-plain">
        {['2025','2022','2021','2018'].map(s => (
          <option value={s} selected={s === schemeId}>{s} Scheme</option>
        ))}
      </select>
    </div>
    {branches && branches.length > 0 && (
      <div>
        <label class="field-label" for="branch-select">Branch</label>
        <select id="branch-select" class="select-plain">
          {branches.map(b => (
            <option value={b.id} selected={b.id === branchId}>{b.short}</option>
          ))}
        </select>
      </div>
    )}
    {tool === 'sgpa' && (
      <div class="sem-wrap">
        <span class="field-label">Semester</span>
        <select id="semester-select" class="sr-only">
          {semesters.map((s) => (
            <option value={s.semester}>{s.name || `Semester ${s.semester}`}</option>
          ))}
        </select>
        <div class="sem-pills" id="sem-pills" role="tablist">
          {semesters.map((s, i) => (
            <button type="button" class:list={['sem-pill', i === 0 && 'is-active']} data-sem={s.semester}>
              Sem {s.semester}
            </button>
          ))}
        </div>
      </div>
    )}
  </div>

  <div class="seg-tabs" role="tablist">
    <a href={`${pathBase}/sgpa`} class:list={['seg-tab', tool === 'sgpa' && 'is-active']}>SGPA</a>
    <a href={`${pathBase}/cgpa`} class:list={['seg-tab', tool === 'cgpa' && 'is-active']}>CGPA</a>
    <a href={`${pathBase}/percentage`} class:list={['seg-tab', tool === 'percentage' && 'is-active']}>Percentage</a>
  </div>

  {cgpaFormulaNote && cgpaFormulaNote.includes('unverified') && (
    <div style="padding: 12px 16px; background: #f5f5f5; color: #333333; margin-bottom: 16px; border: 1px solid #dcdcdc; font-size: 13px;">
      <strong style="display:block; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.06em;">Grading rules being verified</strong>
      {cgpaFormulaNote}
    </div>
  )}

  {tool === 'sgpa' && (
    <>
      {semesters.length > 1 && (
        <label class="lateral">
          <input type="checkbox" id="lateral-entry" />
          Lateral entry — skip semesters 1–2
        </label>
      )}

      <div class="marksheet">
        <div class="marksheet-head">
          <div style="display:flex; align-items:center; gap:10px;">
            <strong class="ink" style="flex:1;">Tap a grade or enter marks. Credits are already filled.</strong>
            <div class="seg-tabs" style="width:auto;">
              <button type="button" class="seg-tab is-active" id="mode-grade">Grade</button>
              <button type="button" class="seg-tab" id="mode-marks">Marks</button>
            </div>
          </div>
          <div style="display:flex; gap:8px; align-items:center;">
            <button type="button" id="save-result-btn" class="button-primary-sm" style="padding:6px 12px; font-size:12px;">Save result</button>
            <button type="button" id="clear-btn" class="button-ghost-sm" style="padding:6px 12px; font-size:12px;">Clear all</button>
          </div>
        </div>
        <div id="subjects-tbody"></div>
      </div>

      <div class="score-dock">
        <div>
          <div class="label">This semester · SGPA</div>
          <div id="sgpa-display" class="score-num">0.00</div>
          <div id="sgpa-class" class="class-badge">Pick grades</div>
        </div>
        <div class="score-meta">
          <div>Credits used <strong id="credits-display">0</strong></div>
          <div>Credit points <strong id="points-display">0</strong></div>
        </div>
      </div>

      <details class="feature-card">
        <summary class="label-sm" style="cursor:pointer;">Show formula &amp; subject breakdown</summary>
        <div style="margin-top: 12px; display: grid; gap: 8px;">
          <div class="code-block">
            <div style="color: var(--color-text-muted); margin-bottom: 4px;">SGPA = Σ (credits × grade point) ÷ Σ credits</div>
            <div id="breakdown" style="color:var(--color-text-strong); white-space:pre-wrap;">—</div>
          </div>
          <p class="body-sm mute" style="margin:0;">Grade points are not rounded before the formula.</p>
        </div>
      </details>
    </>
  )}

  {tool === 'cgpa' && (
    <>
      <div class="marksheet">
        <div class="marksheet-head">
          <div>
            <strong class="ink">Enter each semester’s SGPA</strong>
            <div class="body-sm mute">Credits come from your scheme. Leave a row blank to skip it.</div>
          </div>
          <div style="display:flex; gap:8px; align-items:center;">
            <button type="button" id="save-cgpa-btn" class="button-primary-sm" style="padding:6px 12px; font-size:12px;">Save result</button>
            <button type="button" id="clear-cgpa-btn" class="button-ghost-sm" style="padding:6px 12px; font-size:12px;">Clear all</button>
          </div>
        </div>
        <div>
          {semesters.map((s) => {
            const credits = s.subjects?.reduce((a, b) => a + (b.credits || 0), 0) || 0;
            return (
              <div class="subject-row cgpa-row">
                <div class="sub-meta">
                  <div class="ink" style="font-weight:700;">{s.name || `Semester ${s.semester}`}</div>
                  <div class="mute" style="font-size:12px;">Sem {s.semester}</div>
                </div>
                <div class="sub-credits"><span class="credit-pill">{credits} cr</span></div>
                <input type="number" step="0.01" min="0" max="10" data-sem={s.semester} data-credits={credits} class="cgpa-sgpa-input text-input" placeholder="SGPA e.g. 8.75" />
              </div>
            );
          })}
        </div>
      </div>

      {semesters.length > 1 && (
        <label class="lateral">
          <input type="checkbox" id="cgpa-lateral" />
          Lateral entry — skip first two semesters
        </label>
      )}

      <div class="score-dock">
        <div>
          <div class="label">Overall · CGPA</div>
          <div id="cgpa-display" class="score-num">0.00</div>
          <div id="cgpa-class" class="class-badge">Enter SGPAs</div>
        </div>
        <div class="score-meta">
          <div>Total credits <strong id="cgpa-credits">0</strong></div>
          <div>Total points <strong id="cgpa-points">0</strong></div>
        </div>
      </div>
    </>
  )}

  {tool === 'percentage' && (
    <div class="marksheet" style="padding: 24px; display:grid; gap: 16px;">
      <div>
        <label class="field-label" for="percentage-cgpa">Enter CGPA</label>
        <input type="number" id="percentage-cgpa" class="text-input" step="0.01" min="0" max="10" placeholder="e.g. 8.75" style="max-width:280px;" />
        <p class="body-sm mute" style="margin:8px 0 0;">{cgpaToPercentage.formula ? `Percentage = ${cgpaToPercentage.formula}` : `Percentage = CGPA × ${cgpaToPercentage.multiplier || 10}`}</p>
      </div>
      <div class="score-dock">
        <div>
          <div class="label">Equivalent percentage</div>
          <div id="percentage-display" class="score-num">0.00%</div>
        </div>
      </div>
    </div>
  )}

  <div class="calc-actions">
    <button type="button" id="print-btn" class="button-primary">Print / save</button>
    <button type="button" id="clear-all-btn" class="button-secondary">Clear all</button>
  </div>
  <p class="body-sm mute" style="margin:0; text-align:center;">No personal data is stored. Results live in your browser only.</p>
</section>

<script is:inline>
  (() => {
    const calcRoot = document.getElementById('calculator');
    const gradeTable = JSON.parse(calcRoot.dataset.gradeTable ?? '{}');
    const semesters = JSON.parse(calcRoot.dataset.semesters ?? '[]');
    const branches = JSON.parse(calcRoot.dataset.branches ?? '[]');
    const tool = calcRoot.dataset.tool || 'sgpa';
    const cgpaConfig = JSON.parse(calcRoot.dataset.cgpaConfig ?? '{"cgpaToPercentage":{"multiplier":10},"lateralEntry":{"skipFirstNSemesters":2}}');
    const excludedGrades = JSON.parse(calcRoot.dataset.excludedGrades ?? '[]');
    const uniId = calcRoot.dataset.uniId || 'vtu';
    const schemeId = calcRoot.dataset.scheme;
    const branchId = calcRoot.dataset.branch;
    const multiplier = cgpaConfig?.cgpaToPercentage?.multiplier || 10;
    const lateralSkip = cgpaConfig?.lateralEntry?.skipFirstNSemesters || 2;
    const ctRaw = calcRoot.dataset.classThresholds ?? '[]';
    let classThresholds = [];
    try { classThresholds = JSON.parse(ctRaw); } catch { classThresholds = []; }

    const schemeSelect = document.getElementById('scheme-select');
    const branchSelect = document.getElementById('branch-select');
    const printBtn = document.getElementById('print-btn');
    const clearBtn = document.getElementById('clear-btn');
    const clearAllBtn = document.getElementById('clear-all-btn');
    const saveResultBtn = document.getElementById('save-result-btn');
    const saveCgpaBtn = document.getElementById('save-cgpa-btn');
    const clearCgpaBtn = document.getElementById('clear-cgpa-btn');

    function classLabel(n) {
      if (classThresholds && classThresholds.length) {
        const t = classThresholds.find((x) => {
          const min = x.minCGPA != null ? x.minCGPA : 0;
          const max = x.maxCGPA != null ? x.maxCGPA : Infinity;
          return n >= min && n < max;
        });
        if (t) return t.label || t.class;
      }
      const pct = n * multiplier;
      if (pct >= 70) return 'First class with distinction';
      if (pct >= 60) return 'First class';
      if (pct >= 50) return 'Second class';
      if (n > 0) return 'Pass class';
      return 'Pick grades';
    }

    function buildBasePath() {
      if (branchId && branches && branches.length > 0) {
        return `/${uniId}/${schemeSelect?.value || schemeId}/${branchSelect?.value || branchId}`;
      }
      return `/${uniId}/${schemeSelect?.value || schemeId}`;
    }

    schemeSelect?.addEventListener('change', () => { window.location.href = `${buildBasePath()}/${tool}/`; });
    branchSelect?.addEventListener('change', () => { window.location.href = `${buildBasePath()}/${tool}/`; });

    // --- My Results: save / load ---
    function resultsKey(kind) {
      return `cgpa-results-${kind}-${schemeId}-${branchId || 'na'}`;
    }
    function loadResults(kind) {
      try { return JSON.parse(localStorage.getItem(resultsKey(kind)) ?? '[]'); } catch { return []; }
    }
    function saveResult(kind, entry) {
      const arr = loadResults(kind);
      arr.unshift(entry);
      if (arr.length > 50) arr.pop();
      try { localStorage.setItem(resultsKey(kind), JSON.stringify(arr)); } catch {}
    }
    function renderSavedResults(kind, containerId) {
      const arr = loadResults(kind);
      const container = document.getElementById(containerId);
      if (!container) return;
      if (arr.length === 0) {
        container.innerHTML = '<p class="body-sm mute">No saved results yet. Calculate something and tap "Save result".</p>';
        return;
      }
      container.innerHTML = arr.map((e, i) => `
        <div class="result-item">
          <div class="result-info">
            <div class="result-title">${e.label}</div>
            <div class="result-meta">${e.scheme} · ${e.branch} · ${e.date}</div>
          </div>
          <div class="result-value">${e.value}</div>
          <button type="button" class="delete-btn" data-index="${i}" data-kind="${kind}">Delete</button>
        </div>
      `).join('');
      container.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-index'), 10);
          const kind = btn.getAttribute('data-kind');
          const arr = loadResults(kind);
          arr.splice(idx, 1);
          try { localStorage.setItem(resultsKey(kind), JSON.stringify(arr)); } catch {}
          renderSavedResults(kind, containerId);
        });
      });
    }

    if (tool === 'sgpa') {
      const tbody = document.getElementById('subjects-tbody');
      const sgpaDisplay = document.getElementById('sgpa-display');
      const classEl = document.getElementById('sgpa-class');
      const creditsDisplay = document.getElementById('credits-display');
      const pointsDisplay = document.getElementById('points-display');
      const breakdown = document.getElementById('breakdown');
      const lateralCheckbox = document.getElementById('lateral-entry');
      const semesterSelect = document.getElementById('semester-select');
      const pills = document.getElementById('sem-pills');
      const modeGradeBtn = document.getElementById('mode-grade');
      const modeMarksBtn = document.getElementById('mode-marks');
      let lastCredits = 0;

      function storageKey(semester) {
        return `cgpa-calc-${schemeId}-${branchId || 'na'}-sem${semester}`;
      }
      function loadEntry(semester) {
        try {
          const raw = localStorage.getItem(storageKey(semester));
          return raw ? JSON.parse(raw) : { mode: 'grade', grades: {}, marks: {} };
        } catch { return { mode: 'grade', grades: {}, marks: {} }; }
      }
      function saveEntry(semester, entry) {
        try { localStorage.setItem(storageKey(semester), JSON.stringify(entry)); } catch {}
      }
      function marksToGP(marks) {
        for (const e of Object.values(gradeTable)) {
          if (e.minMarks !== undefined && e.maxMarks !== undefined) {
            if (marks >= e.minMarks && marks <= e.maxMarks) return e.gradePoint;
          }
        }
        return 0;
      }
      const gradeLookup = {};
      for (const e of gradeTable) {
        gradeLookup[e.letter] = e.gradePoint;
        gradeLookup[e.letter.toUpperCase()] = e.gradePoint;
      }
      function resolveGP(input) {
        if (input === undefined || input === null || input === '') return null;
        const key = String(input).trim();
        return gradeLookup[key] ?? null;
      }

      let currentMode = 'grade';
      let manualCourses = [];
      function mKey(semester) { return `cgpa-manual-${schemeId}-${branchId || 'na'}-sem${semester}`; }
      function loadManual(semester) {
        try { return JSON.parse(localStorage.getItem(mKey(semester)) ?? '[]'); } catch { return []; }
      }
      function saveManual(semester, arr) {
        try { localStorage.setItem(mKey(semester), JSON.stringify(arr)); } catch {}
      }
      function manualRowHTML(c, mode, savedVal) {
        const chips = gradeTable.map((g) => {
          const active = savedVal === g ? ' is-active' : '';
          return `<button type="button" class="grade-chip${active}" data-code="${c.code}" data-credits="${c.credits}" data-grade="${g}" data-manual="1" aria-pressed="${savedVal === g}">${g}</button>`;
        }).join('');
        return `<div class="subject-row" data-code="${c.code}" data-credits="${c.credits}" data-marks="" data-grade="${savedVal}" data-manual="1">
          <div class="sub-meta">
            <div class="mute" style="font-size:11px; font-weight:700; letter-spacing:0.04em;">${c.code}</div>
            <div class="ink" style="font-weight:700; font-size:14px;">${c.name}</div>
          </div>
          <div class="sub-credits"><span class="credit-pill">${c.credits} cr</span></div>
          <div class="grade-chips">${chips}</div>
          <button type="button" class="delete-btn" style="margin-left:8px; padding:4px 8px; font-size:12px; background:var(--color-error); color:#fff; border:none; border-radius:6px; cursor:pointer;">×</button>
        </div>`;
      }
      function showError(msg) {
        if (!tbody) return;
        tbody.innerHTML = `<div style="padding:24px; color:var(--color-text-strong); text-align:center; border:1px solid var(--color-border); background:var(--color-surface);">${msg}</div>`;
        if (sgpaDisplay) sgpaDisplay.textContent = '0.00';
        if (classEl) classEl.textContent = 'Error';
        if (creditsDisplay) creditsDisplay.textContent = '0';
        if (pointsDisplay) pointsDisplay.textContent = '0';
        if (breakdown) breakdown.textContent = msg;
      }

      function renderSubjects(semObj) {
        if (!tbody || !semObj) return;
        const saved = loadEntry(semObj.semester);
        manualCourses = loadManual(semObj.semester);
        if (modeGradeBtn) modeGradeBtn.classList.toggle('is-active', currentMode === 'grade');
        if (modeMarksBtn) modeMarksBtn.classList.toggle('is-active', currentMode === 'marks');

        const grades = gradeTable.map(e => e.letter).sort((a, b) => (gradeLookup[b] || 0) - (gradeLookup[a] || 0));
        if (!semObj.subjects || semObj.subjects.length === 0) {
          const list = manualCourses.map((c, i) => manualRowHTML(c, currentMode, (saved.marks && saved.marks[c.code]) ?? (saved.grades && saved.grades[c.code]) ?? '')).join('');
          tbody.innerHTML = `
            <div style="padding:16px 20px; border-bottom:1px solid var(--color-border);">
              <div style="display:flex; gap:8px; align-items:center; margin-bottom:8px;">
                <input type="text" id="manual-code" class="text-input" placeholder="Course code" style="max-width:150px;" />
                <input type="text" id="manual-name" class="text-input" placeholder="Course name" style="flex:1;" />
                <input type="number" id="manual-credits" class="text-input" min="1" max="20" placeholder="Cr" style="max-width:90px;" value="3" />
                <button type="button" id="add-manual-btn" class="button-primary-sm" style="padding:6px 12px; font-size:12px;">Add course</button>
              </div>
              <p class="body-sm mute" style="margin:0 0 10px;">No pre-filled subject data for this branch/semester — add courses manually below.</p>
            </div>
            <div id="manual-list">${list}</div>
          `;
          recompute();
          return;
        }
        tbody.innerHTML = semObj.subjects.map((sub) => {
          const savedVal = currentMode === 'marks'
            ? (saved.marks && saved.marks[sub.code]) ?? ''
            : (saved.grades && saved.grades[sub.code]) ?? '';
          if (currentMode === 'marks') {
            return `<div class="subject-row" data-code="${sub.code || ''}" data-credits="${sub.credits}" data-marks="${savedVal}" data-grade="">
              <div class="sub-meta">
                <div class="mute" style="font-size:11px; font-weight:700; letter-spacing:0.04em;">${sub.code || ''}</div>
                <div class="ink" style="font-weight:700; font-size:14px;">${sub.name}</div>
              </div>
              <div class="sub-credits"><span class="credit-pill">${sub.credits} cr</span></div>
              <input type="number" step="0.5" min="0" max="100" data-code="${sub.code || ''}" data-credits="${sub.credits}" value="${savedVal}" class="marks-input text-input" style="max-width:90px;" placeholder="marks" />
            </div>`;
          }
          const chips = grades.map((g) => {
            const active = savedVal === g ? ' is-active' : '';
            return `<button type="button" class="grade-chip${active}" data-code="${sub.code || ''}" data-credits="${sub.credits}" data-grade="${g}" aria-pressed="${savedVal === g}">${g}</button>`;
          }).join('');
          return `<div class="subject-row" data-code="${sub.code || ''}" data-credits="${sub.credits}" data-marks="" data-grade="${savedVal}">
            <div class="sub-meta">
              <div class="mute" style="font-size:11px; font-weight:700; letter-spacing:0.04em;">${sub.code || ''}</div>
              <div class="ink" style="font-weight:700; font-size:14px;">${sub.name}</div>
            </div>
            <div class="sub-credits"><span class="credit-pill">${sub.credits} cr</span></div>
            <div class="grade-chips">${chips}</div>
          </div>`;
        }).join('');
      }

      function recompute() {
        const selected = parseInt(semesterSelect?.value || '1', 10);
        const excludedSet = new Set(excludedGrades.map(g => g.toUpperCase()));
        let credits = 0, points = 0;
        const lines = [];
        const grades = {};
        const marks = {};

        if (tbody) {
          tbody.querySelectorAll('.subject-row').forEach((row) => {
            const code = row.getAttribute('data-code') || 'SUB';
            const c = parseInt(row.getAttribute('data-credits'), 10);
            const g = row.getAttribute('data-grade') || '';
            const m = row.getAttribute('data-marks') || '';
            const gp = currentMode === 'marks' && m !== '' ? marksToGP(parseFloat(m)) : resolveGP(g);
            const isExcluded = g && excludedSet.has(g.toUpperCase());
            if (currentMode === 'marks' && m !== '') {
              const marksNum = parseFloat(m);
              if (!isNaN(marksNum) && marksNum >= 0 && marksNum <= 100) {
                marks[code] = m;
              }
            }
            if (currentMode === 'grade' && g) {
              grades[code] = g;
            }
            if (gp !== null && !isExcluded) {
              credits += c;
              points += c * gp;
              const label = currentMode === 'marks' && m !== '' ? `${m} marks → ${gp} GP` : `${g}`;
              lines.push(`${code}: ${c} cr × ${gp} = ${c * gp} pts (${label})`);
            }
          });
        }

        const sgpa = credits > 0 ? points / credits : 0;
        if (sgpaDisplay) sgpaDisplay.textContent = credits > 0 ? sgpa.toFixed(2) : '0.00';
        if (classEl) classEl.textContent = credits > 0 ? classLabel(sgpa) : (currentMode === 'marks' ? 'Enter marks' : 'Pick grades');
        if (creditsDisplay) creditsDisplay.textContent = String(credits);
        if (pointsDisplay) pointsDisplay.textContent = points.toFixed(2);
        if (breakdown) breakdown.textContent = lines.length ? lines.join('\n') : `Enter ${currentMode === 'marks' ? 'marks' : 'grades'} above to see the breakdown.`;
        lastCredits = credits;

        if (selected && !isNaN(selected)) {
          saveEntry(selected, { mode: currentMode, ...(currentMode === 'grade' ? { grades } : { marks }) });
        }
      }

      function setSemester(n) {
        if (!semesterSelect) return;
        semesterSelect.value = String(n);
        if (pills) {
          pills.querySelectorAll('.sem-pill').forEach((p) => {
            p.classList.toggle('is-active', p.getAttribute('data-sem') === String(n));
          });
        }
        const saved = loadEntry(n);
        currentMode = saved.mode || 'grade';
        const semObj = semesters.find((s) => s.semester === n);
        if (semObj) {
          renderSubjects(semObj);
          recompute();
        }
      }

      // Init
      try {
        if (semesters.length === 0) {
          showError('No subject data available for this scheme and branch.');
        } else {
          const initialVal = semesterSelect ? parseInt(semesterSelect.value || '1', 10) : 1;
          const initial = semesters.find((s) => s.semester === initialVal) || semesters[0];
          if (initial) setSemester(initial.semester);
        }
      } catch (err) {
        showError('Failed to load subject data. Please refresh the page.');
        console.error('Calculator init error:', err);
      }

      pills?.addEventListener('click', (e) => {
        const btn = e.target.closest('.sem-pill');
        if (!btn) return;
        setSemester(parseInt(btn.getAttribute('data-sem'), 10));
      });

      // Mode toggle — preserves per-semester data via localStorage
      modeGradeBtn?.addEventListener('click', () => {
        if (currentMode === 'grade') return;
        currentMode = 'grade';
        modeGradeBtn.classList.add('is-active');
        modeMarksBtn.classList.remove('is-active');
        const selected = parseInt(semesterSelect?.value || '1', 10);
        renderSubjects(semesters.find((s) => s.semester === selected));
        recompute();
      });
      modeMarksBtn?.addEventListener('click', () => {
        if (currentMode === 'marks') return;
        currentMode = 'marks';
        modeGradeBtn.classList.remove('is-active');
        modeMarksBtn.classList.add('is-active');
        const selected = parseInt(semesterSelect?.value || '1', 10);
        renderSubjects(semesters.find((s) => s.semester === selected));
        recompute();
      });

      tbody?.addEventListener('click', (e) => {
        const del = e.target.closest('.delete-btn');
        if (del) {
          const row = del.closest('.subject-row[data-manual="1"]');
          if (row) {
            const code = row.getAttribute('data-code');
            manualCourses = manualCourses.filter((c) => c.code !== code);
            saveManual(parseInt(semesterSelect?.value || '1', 10), manualCourses);
            const selected = parseInt(semesterSelect?.value || '1', 10);
            renderSubjects(semesters.find((s) => s.semester === selected));
            recompute();
          }
          return;
        }
        const addBtn = e.target.closest('#add-manual-btn');
        if (addBtn) {
          const codeEl = document.getElementById('manual-code');
          const nameEl = document.getElementById('manual-name');
          const crEl = document.getElementById('manual-credits');
          const code = (codeEl?.value || '').trim();
          const name = (nameEl?.value || '').trim();
          const credits = parseInt(crEl?.value || '3', 10) || 3;
          if (!code || !name) return;
          if (manualCourses.some((c) => c.code === code)) return;
          manualCourses.push({ code, name, credits });
          saveManual(parseInt(semesterSelect?.value || '1', 10), manualCourses);
          codeEl.value = '';
          nameEl.value = '';
          const selected = parseInt(semesterSelect?.value || '1', 10);
          renderSubjects(semesters.find((s) => s.semester === selected));
          recompute();
          return;
        }
        if (currentMode !== 'grade') return;
        const btn = e.target.closest('.grade-chip');
        if (!btn) return;
        const row = btn.closest('.subject-row');
        const grade = btn.getAttribute('data-grade');
        const already = row.getAttribute('data-grade') === grade;
        row.querySelectorAll('.grade-chip').forEach((c) => {
          c.classList.remove('is-active');
          c.setAttribute('aria-pressed', 'false');
        });
        if (already) {
          row.setAttribute('data-grade', '');
        } else {
          btn.classList.add('is-active');
          btn.setAttribute('aria-pressed', 'true');
          row.setAttribute('data-grade', grade);
        }
        recompute();
      });

      tbody?.addEventListener('input', (e) => {
        if (currentMode !== 'marks') return;
        const inp = e.target.closest('.marks-input');
        if (!inp) return;
        const row = inp.closest('.subject-row');
        const val = inp.value;
        row.setAttribute('data-marks', val);
        // Validate marks range
        const marksNum = parseFloat(val);
        if (!isNaN(marksNum) && (marksNum < 0 || marksNum > 100)) {
          inp.style.borderColor = 'var(--color-error)';
        } else {
          inp.style.borderColor = '';
        }
        recompute();
      });

      lateralCheckbox?.addEventListener('change', recompute);

      // Save result
      saveResultBtn?.addEventListener('click', () => {
        const selected = parseInt(semesterSelect?.value || '1', 10);
        const sgpa = parseFloat(sgpaDisplay?.textContent || '0');
        const semObj = semesters.find((s) => s.semester === selected);
        const entry = {
          label: semObj ? semObj.name : `Semester ${selected}`,
          value: isNaN(sgpa) || lastCredits === 0 ? '0.00' : sgpa.toFixed(2),
          scheme: schemeId,
          branch: branchId || 'na',
          date: new Date().toLocaleDateString(),
        };
        saveResult('sgpa', entry);
        renderSavedResults('sgpa', 'saved-sgpa-results');
        saveResultBtn.textContent = 'Saved!';
        setTimeout(() => { saveResultBtn.textContent = 'Save result'; }, 1200);
      });

      clearBtn?.addEventListener('click', () => {
        const selected = parseInt(semesterSelect?.value || '1', 10);
        try { localStorage.removeItem(`cgpa-calc-${schemeId}-${branchId || 'na'}-sem${selected}`); } catch {}
        if (lateralCheckbox) lateralCheckbox.checked = false;
        const semObj = semesters.find((s) => s.semester === selected) || semesters[0];
        if (semObj) setSemester(semObj.semester);
      });
    }

    if (tool === 'cgpa') {
      const inputs = document.querySelectorAll('.cgpa-sgpa-input');
      const cgpaDisplay = document.getElementById('cgpa-display');
      const classEl = document.getElementById('cgpa-class');
      const cgpaCredits = document.getElementById('cgpa-credits');
      const cgpaPoints = document.getElementById('cgpa-points');
      const lateral = document.getElementById('cgpa-lateral');

      function recomputeCgpa() {
        let totalCredits = 0, totalPoints = 0;
        const skip = lateral?.checked ? lateralSkip : 0;
        inputs.forEach((inp) => {
          const semNum = parseInt(inp.getAttribute('data-sem') || '0', 10);
          if (skip > 0 && semNum <= skip) return;
          const c = parseFloat(inp.getAttribute('data-credits') || '0');
          const v = parseFloat(inp.value);
          if (!isNaN(v) && v >= 0 && v <= 10 && c > 0) {
            totalCredits += c;
            totalPoints += c * v;
          }
        });
        const cgpa = totalCredits > 0 ? totalPoints / totalCredits : 0;
        cgpaDisplay.textContent = cgpa.toFixed(2);
        classEl.textContent = totalCredits > 0 ? classLabel(cgpa) : 'Enter SGPAs';
        cgpaCredits.textContent = String(totalCredits);
        cgpaPoints.textContent = totalPoints.toFixed(2);
      }

      inputs.forEach(inp => inp.addEventListener('input', recomputeCgpa));
      lateral?.addEventListener('change', recomputeCgpa);
      recomputeCgpa();

      saveCgpaBtn?.addEventListener('click', () => {
        const cgpa = parseFloat(cgpaDisplay.textContent);
        const entry = {
          label: 'Overall CGPA',
          value: cgpa.toFixed(2),
          scheme: schemeId,
          branch: branchId || 'na',
          date: new Date().toLocaleDateString(),
        };
        saveResult('cgpa', entry);
        renderSavedResults('cgpa', 'saved-cgpa-results');
        saveCgpaBtn.textContent = 'Saved!';
        setTimeout(() => { saveCgpaBtn.textContent = 'Save result'; }, 1200);
      });

      clearCgpaBtn?.addEventListener('click', () => {
        document.querySelectorAll('.cgpa-sgpa-input').forEach(i => { i.value = ''; });
        document.getElementById('cgpa-lateral').checked = false;
        document.querySelectorAll('.cgpa-sgpa-input')[0]?.dispatchEvent(new Event('input'));
      });
    }

    if (tool === 'percentage') {
      const input = document.getElementById('percentage-cgpa');
      const disp = document.getElementById('percentage-display');
      const cgpaConfig = JSON.parse(calcRoot.dataset.cgpaConfig ?? '{}');
      const pctConfig = cgpaConfig?.cgpaToPercentage ?? { multiplier: 10 };
      const multiplier = pctConfig.multiplier ?? 10;
      const formula = pctConfig.formula;
      const pctNote = pctConfig.note;
      const alternatives = pctConfig.alternatives;

      // Safe formula evaluator: only allows numbers, CGPA variable, + - * / ( ) .
      function evalPctFormula(cgpa, f) {
        const sanitized = f.replace(/CGPA/g, String(cgpa));
        if (!/^[0-9\s\.\+\-\*\/\(\)]+$/.test(sanitized)) return null;
        try {
          return new Function('return ' + sanitized)();
        } catch { return null; }
      }

      function calc() {
        const v = parseFloat(input.value);
        if (isNaN(v)) { disp.textContent = '0.00%'; return; }
        let result;
        if (formula) {
          result = evalPctFormula(v, formula);
          if (result === null) result = v * multiplier;
        } else {
          result = v * multiplier;
        }
        disp.textContent = result.toFixed(2) + '%';
      }

      // Show formula info below the input
      const formulaInfo = document.createElement('div');
      formulaInfo.style.fontSize = '12px';
      formulaInfo.style.color = 'var(--color-text-muted)';
      formulaInfo.style.marginTop = '8px';
      formulaInfo.style.maxWidth = '280px';
      if (formula) {
        formulaInfo.textContent = `Formula: ${formula}` + (pctNote ? ` — ${pctNote}` : '');
      }
      input?.parentElement?.appendChild(formulaInfo);

      input?.addEventListener('input', calc);
    }

    printBtn?.addEventListener('click', () => window.print());
    clearAllBtn?.addEventListener('click', () => {
      if (tool === 'sgpa') {
        const semesterSelect = document.getElementById('semester-select');
        const selected = parseInt(semesterSelect?.value || '1', 10);
        try { localStorage.removeItem(`cgpa-calc-${schemeId}-${branchId || 'na'}-sem${selected}`); } catch {}
        document.getElementById('lateral-entry').checked = false;
        const semObj = semesters.find((s) => s.semester === selected) || semesters[0];
        if (semObj) {
          const event = new Event('click');
          document.querySelector(`.sem-pill[data-sem="${semObj.semester}"]`)?.click();
        }
      }
      if (tool === 'cgpa') {
        document.querySelectorAll('.cgpa-sgpa-input').forEach(i => { i.value = ''; });
        document.getElementById('cgpa-lateral').checked = false;
        document.querySelectorAll('.cgpa-sgpa-input')[0]?.dispatchEvent(new Event('input'));
      }
      if (tool === 'percentage') {
        const input = document.getElementById('percentage-cgpa');
        if (input) input.value = '';
        document.getElementById('percentage-display').textContent = '0.00%';
      }
    });
  })();
</script>

