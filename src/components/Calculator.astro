  #subjects-tbody select:focus { outline: 2px solid var(--color-primary); outline-offset: -1px; border-color: var(--color-primary); }
  .cgpa-sgpa-input:focus { outline: 2px solid var(--color-primary); outline-offset: -1px; border-color: var(--color-primary); }
  #percentage-cgpa:focus { outline: 2px solid var(--color-primary); outline-offset: -1px; border-color: var(--color-primary); }
