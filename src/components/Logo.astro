---
interface Props {
  size?: number;
}

const { size = 36 } = Props;
---

<span class="logo-wrap" style="width:{size}px; height:{size}px;" aria-label="CGPA Calculator AI logo">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" style="width:100%; height:100%; display:block;">
    <rect x="2" y="2" width="28" height="28" rx="8" ry="8" fill="#f8f7f3"/>
    <path d="M 7 8 L 25 8 M 25 8 L 9 24 M 9 24 L 25 24"
          stroke="#0d2442" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  </svg>
</span>

<style>
  .logo-wrap { display: inline-flex; align-items: center; justify-content: center; }
</style>
