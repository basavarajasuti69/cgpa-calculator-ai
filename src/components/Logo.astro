---
interface Props {
  size?: number;
}

const { size = 36 } = Props;
---

<span class="logo-wrap" style="width:{size}px; height:{size}px;" aria-label="CGPA Calculator AI logo">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" style="width:100%; height:100%; display:block;">
    <rect x="2" y="2" width="28" height="28" rx="8" ry="8" fill="var(--color-surface)" stroke="var(--color-border)"/>
    <g stroke="var(--color-text-strong)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none">
      <path d="M 9 10 L 16 16 L 9 22"/>
      <line x1="18" y1="22" x2="23" y2="22"/>
    </g>
  </svg>
</span>

<style>
  .logo-wrap { display: inline-flex; align-items: center; justify-content: center; }
</style>
