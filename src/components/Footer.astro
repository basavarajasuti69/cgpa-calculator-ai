---
const { noAds = false } = Astro.props;
---

<footer>
  <div class="container footer-grid">
    <div>
      <div class="footer-brand">
        <span class="logo-wrap" style="width:30px; height:30px;" aria-label="CGPA Calculator AI logo">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" style="width:100%; height:100%; display:block;">
            <rect x="2" y="2" width="28" height="28" rx="8" ry="8" fill="#f8f7f3"/>
            <path d="M 7 8 L 25 8 M 25 8 L 9 24 M 9 24 L 25 24" stroke="#0d2442" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </span>
        <div>
          <div class="footer-title">CGPA Calculator AI</div>
          <div class="footer-sub">Free calculators for VTU, Anna, KTU, SRM, VIT, IPU &amp; Saveetha</div>
        </div>
      </div>
      <p class="footer-text" style="margin-top: 12px;">Accurate SGPA/CGPA &amp; percentage calculators. No personal data stored.</p>
    </div>
    <div>
      <div class="footer-heading">Tools</div>
      <ul class="footer-list">
        <li><a href="/vtu">VTU Calculators</a></li>
        <li><a href="/universities">All Universities</a></li>
        <li><a href="/tools/converter">Percentage &amp; CGPA Converter</a></li>
        <li><a href="/my-results">My Results</a></li>
      </ul>
    </div>
    <div>
      <div class="footer-heading">Company</div>
      <ul class="footer-list">
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/privacy">Privacy Policy</a></li>
        <li><a href="/terms">Terms</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {new Date().getFullYear()} CGPA Calculator AI. All rights reserved.</p>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--color-border); background: color-mix(in srgb, var(--color-bg) 98%, transparent); margin-top: 80px; }
  .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 32px; padding: 40px 16px; }
  .footer-brand { display: flex; align-items: center; gap: 12px; }
  .footer-title { font-weight: 700; color: var(--color-text-strong); }
  .footer-sub { color: var(--color-text-muted); font-size: 13px; }
  .footer-text { color: var(--color-text); font-size: 14px; }
  .footer-heading { font-weight: 600; color: var(--color-text-strong); margin-bottom: 10px; }
  .footer-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .footer-list a { color: var(--color-text); text-decoration: none; }
  .footer-list a:hover { color: var(--color-text-strong); }
  .footer-bottom { padding: 16px; border-top: 1px solid var(--color-border); color: var(--color-text-muted); font-size: 13px; }
  @media (max-width: 800px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
