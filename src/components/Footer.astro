---
const { noAds = false } = Astro.props;
---

<footer>
  <div class="container footer-grid">
    <div>
      <div class="footer-brand">
        <span class="brand-mark">Σ</span>
        <div>
          <div class="ink" style="font-family: var(--font-family-serif); font-size: 22px;">CGPA Studio</div>
          <div class="body-sm" style="color:var(--color-muted);">Marks-card calculator for university students</div>
        </div>
      </div>
      <p class="body-sm" style="max-width: 420px; color:var(--color-body); margin-top: 16px;">
        SGPA, CGPA and percentage — credits pre-filled, formulas visible, nothing stored on a server. Built for VTU, Anna, KTU, SRM, VIT, IPU and Saveetha.
      </p>
      <div style="display:flex; gap:10px; margin-top: 14px;">
        <button type="button" id="footer-theme-toggle" class="theme-toggle" style="margin-left:0;" title="Toggle dark mode">🌙</button>
      </div>
    </div>
    <div class="footer-cols">
      <div>
        <p class="footer-head">Calculate</p>
        <a href="/vtu/2022/cse/sgpa">SGPA</a>
        <a href="/vtu/2022/cse/cgpa">CGPA</a>
        <a href="/vtu/2022/cse/percentage">Percentage</a>
        <a href="/tools/planner">Target planner</a>
        <a href="/my-results">My results</a>
      </div>
      <div>
        <p class="footer-head">Site</p>
        <a href="/universities">Universities</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/request-college">Request a college</a>
        <a href="/tools/ask">Ask AI</a>
      </div>
      <div>
        <p class="footer-head">Legal</p>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/disclaimer">Disclaimer</a>
      </div>
    </div>
  </div>
  <div class="container" style="margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--color-hairline); display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap;">
    <span class="body-sm" style="color:var(--color-muted);">© {new Date().getFullYear()} CGPA Calculator AI · Not affiliated with VTU.</span>
    {!noAds && <span class="body-sm" style="color:var(--color-muted);">No ads. No login. Just grades.</span>}
  </div>
</footer>

<style>
  .footer-grid { display: grid; gap: 32px; }
  @media (min-width: 800px) {
    .footer-grid { grid-template-columns: 1.2fr 1.4fr; align-items: start; }
  }
  .footer-brand { display: flex; gap: 12px; align-items: center; }
  .footer-cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .footer-head { margin: 0 0 10px; color: #f4c430; font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  .footer-cols a { display: block; margin-bottom: 8px; font-size: 14px; font-weight: 600; color: #f4efe4; }
  .footer-cols a:hover { color: var(--color-link); text-decoration: underline; }
  @media (max-width: 640px) {
    .footer-cols { grid-template-columns: 1fr 1fr; }
  }
</style>

<script is:inline>
  (() => {
    const btn = document.getElementById('footer-theme-toggle');
    if (!btn) return;
    const html = document.documentElement;
    const isDark = html.getAttribute('data-theme') === 'dark';
    btn.textContent = isDark ? '☀️' : '🌙';
    btn.addEventListener('click', () => {
      const nowDark = html.getAttribute('data-theme') === 'dark';
      if (nowDark) {
        html.removeAttribute('data-theme');
        localStorage.setItem('cgpa-theme', 'light');
        btn.textContent = '🌙';
      } else {
        html.setAttribute('data-theme', 'dark');
        localStorage.setItem('cgpa-theme', 'dark');
        btn.textContent = '☀️';
      }
    });
  })();
</script>
