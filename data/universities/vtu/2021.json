  },
  "scheme": {
    "id": "2021",
    "name": "VTU 2021 Scheme",
    "status": "draft",
    "sources": [
      {
        "url": "https://vtu.ac.in/wp-content/uploads/2021/12/BE-BTech-Regulation-2021-draft.pdf",
        "clauses": ["21OB12.0", "21OB12.1", "21OB12.2", "21OB12.3"],
        "retrievedDate": "2026-10-24"
      }
    ],
    "gradeTable": [
      { "letter": "S", "gradePoint": 10, "minMarks": 90, "maxMarks": 100 },
      { "letter": "A", "gradePoint": 9, "minMarks": 80, "maxMarks": 89 },
      { "letter": "B", "gradePoint": 8, "minMarks": 70, "maxMarks": 79 },
      { "letter": "C", "gradePoint": 7, "minMarks": 60, "maxMarks": 69 },
      { "letter": "D", "gradePoint": 6, "minMarks": 45, "maxMarks": 59 },
      { "letter": "E", "gradePoint": 4, "minMarks": 40, "maxMarks": 44 },
      { "letter": "F", "gradePoint": 0, "minMarks": 0, "maxMarks": 39 },
      { "letter": "Absent", "gradePoint": 0, "minMarks": 0, "maxMarks": 0 }
    ],
    "gradeScale": {
      "S": 10, "A": 9, "B": 8, "C": 7, "D": 6, "E": 4, "F": 0, "Absent": 0, "AB": 0
    },
    "formulaType": "credit-weighted",
    "cgpaToPercentage": { "multiplier": "unverified", "formula": "(CGPA - 0.75) * 10", "source": "21OB12.2 (draft)" },
    "lateralEntry": { "skipFirstNSemesters": 2 },
    "totalCredits": { "regular": 160, "lateral": 120 },
    "backlogPolicy": {
      "sgpa": "SGPA = sum(CourseCredits*GradePoints)/sum(CourseCredits) for all courses in that semester (21OB12.1)",
      "cgpa": "CGPA = sum(CourseCredits*GradePoints) for all courses excluding those with F grades until that semester / sum(CourseCredits) for all courses excluding those with F grades until that semester (21OB12.1) - F-credits excluded from CGPA denominator; pass requires GP>=4",
      "notes": "Per 21OB12.1 in draft: CGPA excludes courses with F grades until cleared (similar exclusion pattern)."
    },
    "classThresholds": [
      { "class": "FCD", "minPercent": 70, "label": "First Class with Distinction" },
      { "class": "FC", "minPercent": 60, "maxPercent": 70, "label": "First Class" },
      { "class": "SC", "minPercent": 50, "maxPercent": 60, "label": "Second Class" },
      { "class": "P", "minPercent": 42.5, "maxPercent": 50, "label": "Pass Class" }
    ],
    "passCriteria": { "minGP": 4 },
    "nonGradedExcluded": ["DX", "NS", "NP", "PP", "W"],
    "rounding": "to 2 decimals",
    "sourceUrl": "https://vtu.ac.in/wp-content/uploads/2021/12/BE-BTech-Regulation-2021-draft.pdf",
    "lastVerified": "2026-10-24"
  }
}
